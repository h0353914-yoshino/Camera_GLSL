#version 300 es
precision highp int;
precision highp float;

uniform highp sampler2D inputTexture;
uniform highp ivec2 outputTexDimension;
uniform highp ivec2 inputPixelOffset;
uniform highp ivec2 inputTexDimension;
in highp vec2 texCoord;
out mediump vec4 fragColor;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample43;
    highp vec4 sample45;
    highp vec4 sample47;
    highp vec4 sample49;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    mediump float hr1_w;
    mediump float hr1_x;
    mediump float hr1_y;
    mediump float hr1_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_w;
    highp float r4_x;
    highp float r4_y;
    highp float r4_z;
    highp float r5_w;
    highp float r5_x;
    highp float r5_y;
    highp float r5_z;
    highp float r6_w;
    highp float r6_x;
    highp float r6_y;
    highp float r6_z;
    outputTexDimension;
    inputPixelOffset;
    inputTexDimension;
    r0_z = texCoord.x;
    r0_w = texCoord.y;
    r0_x = float(inputTexDimension.x);
    hr0_x = float(inputPixelOffset.x);
    hr0_y = float(inputPixelOffset.y);
    r0_y = float(inputTexDimension.y);
    r1_x = float(outputTexDimension.x);
    r1_y = float(outputTexDimension.y);
    hr0_w = 0.0;
    r0_x = 1.0 / r0_x;
    r0_z = r0_z * r1_x;
    r0_w = r0_w * r1_y;
    r0_y = 1.0 / r0_y;
    r6_x = 0.0;
    r0_z = float(int(r0_z));
    r0_w = float(int(r0_w));
    hr0_z = 0.0;
    hr1_x = r0_z;
    hr1_y = r0_w;
    hr1_z = r0_x;
    hr1_x = hr1_x * exp2(2.0);
    hr1_y = hr1_y * exp2(4.0);
    hr1_w = r0_y;
    hr0_x = hr0_x + hr1_x;
    hr0_y = hr0_y + hr1_y;
    hr0_x = hr0_x;
    hr0_y = hr0_y;
    r0_z = hr0_x + 0.5;
    r0_w = hr0_y + 0.5;
    hr0_x = r0_x * r0_z;
    hr0_y = r0_y * r0_w;
    r0_z = 0.0 * hr1_z + hr0_x;
    r1_x = 2.0 * hr1_z + hr0_x;
    r0_x = 3.0 * hr1_z + hr0_x;
    r6_w = r6_x;
    r6_z = r6_x;
    r6_y = r6_x;
    while (true)
    {
        r1_z = hr0_x + hr1_z;
        hr1_x = hr0_z;
        hr0_z = hr0_z + 1.0;
        r0_y = hr1_x * hr1_w + hr0_y;
        p0 = hr0_z < 16.0;
        r0_w = r0_y;
        r1_w = r0_y;
        r1_y = r0_y;
        sample43 = texture(inputTexture, vec2(r0_x, r0_y));
        r2_x = sample43.x;
        r2_y = sample43.y;
        r2_z = sample43.z;
        r2_w = sample43.w;
        sample45 = texture(inputTexture, vec2(r0_z, r0_w));
        r3_x = sample45.x;
        r3_y = sample45.y;
        r3_z = sample45.z;
        r3_w = sample45.w;
        sample47 = texture(inputTexture, vec2(r1_z, r1_w));
        r4_x = sample47.x;
        r4_y = sample47.y;
        r4_z = sample47.z;
        r4_w = sample47.w;
        sample49 = texture(inputTexture, vec2(r1_x, r1_y));
        r5_x = sample49.x;
        r5_y = sample49.y;
        r5_z = sample49.z;
        r5_w = sample49.w;
        r0_y = r3_x + r6_w;
        r0_w = r3_y + r6_z;
        r1_y = r3_z + r6_y;
        r1_z = r3_w + r6_x;
        r0_y = r0_y + r4_x;
        r0_w = r0_w + r4_y;
        r1_y = r1_y + r4_z;
        r1_z = r1_z + r4_w;
        r0_y = r0_y + r5_x;
        r0_w = r0_w + r5_y;
        r1_y = r1_y + r5_z;
        r1_z = r1_z + r5_w;
        r0_y = r0_y + r2_x;
        r0_w = r0_w + r2_y;
        r1_y = r1_y + r2_z;
        r6_x = r1_z + r2_w;
        if (!p0) break;
        r6_w = r0_y;
        r6_z = r0_w;
        r6_y = r1_y;
    }
    r0_x = r0_y + r0_w;
    r0_x = r0_x + r1_y;
    r0_x = r0_x + r6_x;
    hr0_x = r0_x * 0.00390625;
    hr0_y = hr0_w;
    hr0_z = hr0_w;
    fragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
