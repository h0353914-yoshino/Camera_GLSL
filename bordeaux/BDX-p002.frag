#version 300 es
precision highp int;
precision highp float;

uniform highp sampler2D inputTexture;
uniform highp ivec2 outputTexDimension;
uniform highp ivec2 inputTexDimension;
in highp vec2 texCoord;
out mediump vec4 fragColor;

void main()
{
    bool p0;
    bool p1;
    mediump vec4 sample29;
    mediump vec4 sample36;
    mediump vec4 sample38;
    mediump vec4 sample40;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    mediump float hr1_w;
    mediump float hr1_x;
    mediump float hr1_y;
    mediump float hr1_z;
    mediump float hr2_w;
    mediump float hr2_x;
    mediump float hr2_y;
    mediump float hr2_z;
    mediump float hr3_w;
    mediump float hr3_x;
    mediump float hr3_y;
    mediump float hr3_z;
    mediump float hr4_x;
    mediump float hr4_y;
    mediump float hr4_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    outputTexDimension;
    inputTexDimension;
    r0_z = texCoord.x;
    r0_w = texCoord.y;
    r0_x = float(inputTexDimension.x);
    r0_y = float(inputTexDimension.y);
    r1_x = float(outputTexDimension.y);
    r1_y = float(outputTexDimension.x);
    r0_w = r0_w * r1_x;
    r0_z = r0_z * r1_y;
    r0_y = 1.0 / r0_y;
    r0_x = 1.0 / r0_x;
    r0_w = float(int(r0_w));
    r0_z = float(int(r0_z));
    hr0_x = r0_w;
    hr0_y = r0_z;
    hr0_x = hr0_x * exp2(2.0);
    hr0_y = hr0_y;
    hr0_z = r0_y;
    hr0_x = hr0_x;
    r0_z = hr0_y + 0.5;
    r0_w = hr0_x + 0.5;
    r0_x = r0_x * r0_z;
    r0_y = r0_y * r0_w;
    hr0_x = r0_x;
    hr0_y = r0_y;
    r0_z = hr0_x + 0.0;
    r0_w = 2.0 * hr0_z + hr0_y;
    sample29 = texture(inputTexture, vec2(r0_x, r0_y));
    hr0_w = sample29.x;
    hr1_x = sample29.y;
    hr1_y = sample29.z;
    hr1_z = sample29.w;
    r0_x = hr0_y + hr0_z;
    r1_x = r0_z;
    r1_z = r0_z;
    r1_w = r0_w;
    r1_y = r0_x;
    r0_w = 3.0 * hr0_z + hr0_y;
    sample36 = texture(inputTexture, vec2(r1_z, r1_w));
    hr1_w = sample36.x;
    hr2_x = sample36.y;
    hr2_y = sample36.z;
    hr2_z = sample36.w;
    sample38 = texture(inputTexture, vec2(r1_x, r1_y));
    hr2_w = sample38.x;
    hr3_x = sample38.y;
    hr3_y = sample38.z;
    hr3_z = sample38.w;
    sample40 = texture(inputTexture, vec2(r0_z, r0_w));
    hr3_w = sample40.x;
    hr4_x = sample40.y;
    hr4_y = sample40.z;
    hr4_z = sample40.w;
    hr0_x = hr0_w + hr2_w;
    hr0_y = hr1_x + hr3_x;
    hr0_z = hr1_y + hr3_y;
    hr0_w = hr1_z + hr3_z;
    hr0_x = hr0_x + hr1_w;
    hr0_y = hr0_y + hr2_x;
    hr0_z = hr0_z + hr2_y;
    hr0_w = hr0_w + hr2_z;
    hr0_x = hr0_x + hr3_w;
    hr0_y = hr0_y + hr4_x;
    hr0_z = hr0_z + hr4_y;
    hr0_w = hr0_w + hr4_z;
    hr0_x = hr0_x + hr0_y;
    hr0_x = hr0_x + hr0_z;
    hr0_x = hr0_x + hr0_w;
    hr0_x = hr0_x * 0.0625;
    hr0_y = 0.0;
    hr0_z = 0.0;
    hr0_w = 0.0;
    fragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
