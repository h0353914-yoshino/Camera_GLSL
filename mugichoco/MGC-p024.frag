#version 100
precision highp float;

uniform highp sampler2D texUnitImage;
uniform highp sampler2D texUnitVec;
uniform highp vec2 pixSize;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample15;
    highp vec4 sample17;
    highp vec4 sample19;
    highp vec4 sample21;
    mediump vec4 sample72;
    mediump vec4 sample74;
    mediump vec4 sample76;
    mediump vec4 sample78;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_w;
    highp float r4_x;
    highp float r4_y;
    highp float r4_z;
    highp float r5_w;
    highp float r5_x;
    highp float r5_y;
    highp float r5_z;
    highp float r6_w;
    highp float r6_x;
    highp float r6_y;
    highp float r6_z;
    highp float r7_x;
    highp float r7_y;
    pixSize;
    r0_z = texCoord.x;
    r0_w = texCoord.y;
    r0_x = pixSize.x;
    r0_y = r0_w + 0.0;
    r1_y = r0_w;
    r1_z = (-1.5) * r0_x + r0_z;
    r1_w = (-0.5) * r0_x + r0_z;
    r2_x = 0.5 * r0_x + r0_z;
    r0_x = 1.5 * r0_x + r0_z;
    r1_x = r1_z;
    r2_y = r1_w;
    r2_z = r0_w;
    r2_w = r2_x;
    r3_x = r0_y;
    r3_y = r0_x;
    r3_z = r0_y;
    sample15 = texture2D(texUnitVec, vec2(r1_x, r1_y));
    r3_w = sample15.x;
    r4_x = sample15.y;
    r4_y = sample15.z;
    r4_z = sample15.w;
    sample17 = texture2D(texUnitVec, vec2(r2_y, r2_z));
    r4_w = sample17.x;
    r5_x = sample17.y;
    r5_y = sample17.z;
    r5_z = sample17.w;
    sample19 = texture2D(texUnitVec, vec2(r2_w, r3_x));
    r2_y = sample19.x;
    r2_z = sample19.y;
    r2_w = sample19.z;
    r3_x = sample19.w;
    sample21 = texture2D(texUnitVec, vec2(r3_y, r3_z));
    r5_w = sample21.x;
    r6_x = sample21.y;
    r6_y = sample21.z;
    r6_z = sample21.w;
    r0_z = r4_x * 255.0;
    r1_x = r4_z * 255.0;
    r1_y = r5_x * 255.0;
    r3_y = r5_z * 255.0;
    r2_z = r2_z * 255.0;
    r3_x = r3_x * 255.0;
    r3_z = r6_x * 255.0;
    r4_x = r6_z * 255.0;
    r4_z = (r0_z < 128.0) ? 1.0 : 0.0;
    r5_x = (r1_x < 128.0) ? 1.0 : 0.0;
    r5_z = (r1_y < 128.0) ? 1.0 : 0.0;
    r6_x = (r3_y < 128.0) ? 1.0 : 0.0;
    r6_z = (r2_z < 128.0) ? 1.0 : 0.0;
    r6_w = (r3_x < 128.0) ? 1.0 : 0.0;
    r7_x = (r3_z < 128.0) ? 1.0 : 0.0;
    r7_y = (r4_x < 128.0) ? 1.0 : 0.0;
    r0_z = r0_z * 256.0;
    r1_x = r1_x * 256.0;
    r1_y = r1_y * 256.0;
    r3_y = r3_y * 256.0;
    r2_z = r2_z * 256.0;
    r3_x = r3_x * 256.0;
    r3_z = r3_z * 256.0;
    r4_x = r4_x * 256.0;
    r0_z = 255.0 * r3_w + r0_z;
    r1_x = 255.0 * r4_y + r1_x;
    r3_w = (r4_z != 0.0) ? 0.0 : 65536.0;
    r4_y = (r5_x != 0.0) ? 0.0 : 65536.0;
    r1_y = 255.0 * r4_w + r1_y;
    r3_y = 255.0 * r5_y + r3_y;
    r4_z = (r5_z != 0.0) ? 0.0 : 65536.0;
    r4_w = (r6_x != 0.0) ? 0.0 : 65536.0;
    r2_y = 255.0 * r2_y + r2_z;
    r2_z = 255.0 * r2_w + r3_x;
    r2_w = (r6_z != 0.0) ? 0.0 : 65536.0;
    r3_x = (r6_w != 0.0) ? 0.0 : 65536.0;
    r3_z = 255.0 * r5_w + r3_z;
    r4_x = 255.0 * r6_y + r4_x;
    r5_x = (r7_x != 0.0) ? 0.0 : 65536.0;
    r5_y = (r7_y != 0.0) ? 0.0 : 65536.0;
    r0_z = r0_z - r3_w;
    r1_x = r1_x - r4_y;
    r1_y = r1_y - r4_z;
    r3_y = r3_y - r4_w;
    r2_y = r2_y - r2_w;
    r2_z = r2_z - r3_x;
    r2_w = r3_z - r5_x;
    r3_x = r4_x - r5_y;
    r3_z = pixSize.x * r0_z + r1_z;
    r3_w = pixSize.y * r1_x + r0_w;
    r0_z = pixSize.x * r1_y + r1_w;
    r0_w = pixSize.y * r3_y + r0_w;
    r1_x = pixSize.x * r2_y + r2_x;
    r1_y = pixSize.y * r2_z + r0_y;
    r0_x = pixSize.x * r2_w + r0_x;
    r0_y = pixSize.y * r3_x + r0_y;
    sample72 = texture2D(texUnitImage, vec2(r3_z, r3_w));
    hr0_x = sample72.x;
    sample74 = texture2D(texUnitImage, vec2(r0_z, r0_w));
    hr0_y = sample74.x;
    sample76 = texture2D(texUnitImage, vec2(r1_x, r1_y));
    hr0_z = sample76.x;
    sample78 = texture2D(texUnitImage, vec2(r0_x, r0_y));
    hr0_w = sample78.x;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
