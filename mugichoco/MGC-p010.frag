    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_x;
    pixSize;
    r0_z = texCoord.x;
    r0_w = texCoord.y;
    r0_x = 1.0;
    r0_y = r0_z + 0.5;
    r1_x = r0_w + 0.0;
    r0_z = r0_z - 0.5;
    r1_z = pixSize.y * r0_w;
    r1_w = pixSize.x * r0_y;
    r2_x = pixSize.y * r1_x;
    r1_y = pixSize.x * r0_z;
    r0_x = 0.0;
    sample12 = texture2D(texUnitVec, vec2(r1_w, r2_x));
    r1_w = sample12.x;
    r2_x = sample12.y;
    r2_y = sample12.z;
    r2_z = sample12.w;
