    r2_w = sample14.x;
    r3_x = sample14.y;
    r3_y = sample14.z;
    r3_z = sample14.w;
    r1_y = r2_x * 255.0;
    r1_z = r3_x * 255.0;
    r2_x = r3_z * 255.0;
    r2_z = r2_z * 255.0;
    r3_x = (r1_y < 128.0) ? 1.0 : 0.0;
    r3_z = (r1_z < 128.0) ? 1.0 : 0.0;
