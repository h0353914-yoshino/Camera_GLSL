    r2_z = sign(r2_x);
    r2_w = sign(r1_y);
    r3_x = sign(r1_w);
    r1_z = r1_z * r2_y;
    r2_x = r2_x * r2_z;
    r1_y = r1_y * r2_w;
    r1_w = r1_w * r3_x;
    r1_z = floor(r1_z);
    r2_x = floor(r2_x);
    r1_y = floor(r1_y);
    r1_w = floor(r1_w);
    r0_z = r1_z * r2_y + r0_z;
    r0_w = r2_x * r2_z + r0_w;
    r0_y = r1_y * r2_w + r0_y;
