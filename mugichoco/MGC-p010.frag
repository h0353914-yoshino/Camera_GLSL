    r3_y = (r3_w != 0.0) ? 0.0 : 65536.0;
    r1_y = 255.0 * r1_w + r1_y;
    r1_w = 255.0 * r2_y + r2_z;
    r2_y = (r3_x != 0.0) ? 0.0 : 65536.0;
    r2_z = (r4_x != 0.0) ? 0.0 : 65536.0;
    r1_z = r1_z - r2_w;
    r2_x = r2_x - r3_y;
    r1_y = r1_y - r2_y;
    r1_w = r1_w - r2_z;
