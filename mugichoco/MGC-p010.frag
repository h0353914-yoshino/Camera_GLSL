    r1_z = sample65.y;
    r1_w = sample65.z;
    r2_x = sample65.w;
    r2_y = 0.0 * r1_x;
    r2_z = 0.0 * r1_x;
    r1_x = 0.0 * r1_x;
    r2_w = 0.0 * r2_x;
    r3_x = 0.0 * r2_x;
    r2_x = 0.0 * r2_x;
    r2_y = 0.0 * r0_w + r2_y;
    r2_z = 0.0 * r0_w + r2_z;
    r0_w = 0.0 * r0_w + r1_x;
    r2_w = 0.0 * r1_w + r2_w;
    r3_x = 0.0 * r1_w + r3_x;
    r1_x = 0.0 * r1_w + r2_x;
    r1_w = 0.0 * r0_z + r2_y;
    r2_x = 0.0 * r0_z + r2_z;
    r0_w = 0.0 * r0_z + r0_w;
    r2_y = 0.0 * r1_z + r2_w;
    r2_z = 0.0 * r1_z + r3_x;
    r1_x = 0.0 * r1_z + r1_x;
    r1_w = 0.0 * r0_y + r1_w;
    r2_x = 0.0 * r0_y + r2_x;
    r0_w = 0.0 * r0_y + r0_w;
    r2_y = 0.0 * r1_y + r2_y;
    r2_z = 0.0 * r1_y + r2_z;
    r0_w = 0.0 * r1_y + r1_x;
