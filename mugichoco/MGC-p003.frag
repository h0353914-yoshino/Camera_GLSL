#version 100
precision highp float;

uniform highp sampler2D texUnit;
uniform highp vec4 translateParam;
uniform highp mat2 rotationParam;
uniform highp vec4 pixSize;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample33;
    highp vec4 sample35;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_y;
    translateParam;
    rotationParam;
    pixSize;
    r0_z = texCoord.x;
    r0_w = texCoord.y;
    r0_x = 2.0 * r0_w + 0.5;
    r0_y = 2.0 * r0_z + 0.5;
    r0_x = floor(r0_x);
    r0_y = floor(r0_y);
    r0_z = 0.5 * r0_x + 0.0;
    r0_w = 0.5 * r0_y + -0.5;
    r0_y = 0.5 * r0_y + 0.5;
    r0_x = 0.5 * r0_x + (-translateParam.w);
    r0_z = r0_z - translateParam.w;
    r0_w = r0_w - translateParam.z;
    r0_y = r0_y - translateParam.z;
    r1_x = rotationParam[1][0] * r0_x;
    r0_x = rotationParam[1][1] * r0_x;
    r1_y = rotationParam[1][0] * r0_z;
    r0_z = rotationParam[1][1] * r0_z;
    r1_x = rotationParam[0][0] * r0_w + r1_x;
    r0_x = rotationParam[0][1] * r0_w + r0_x;
    r0_w = rotationParam[0][0] * r0_y + r1_y;
    r0_y = rotationParam[0][1] * r0_y + r0_z;
    r0_z = r1_x + translateParam.x;
    r0_x = r0_x + translateParam.y;
    r0_w = r0_w + translateParam.x;
    r0_y = r0_y + translateParam.y;
    r0_z = r0_z + translateParam.z;
    r0_x = r0_x + translateParam.w;
    r0_w = r0_w + translateParam.z;
    r0_y = r0_y + translateParam.w;
    r1_x = r0_z * pixSize.x;
    r1_y = r0_x * pixSize.y;
    r0_x = r0_w * pixSize.x;
    r0_y = r0_y * pixSize.y;
    sample33 = texture2D(texUnit, vec2(r1_x, r1_y));
    r0_z = sample33.x;
    r1_y = sample33.w;
    sample35 = texture2D(texUnit, vec2(r0_x, r0_y));
    r1_z = sample35.x;
    r2_y = sample35.w;
    r0_x = 255.0 * r1_y + 0.5;
    r0_y = 255.0 * r0_z + 0.5;
    r0_z = 255.0 * r2_y + 0.5;
    r0_w = 255.0 * r1_z + 0.5;
    r0_x = floor(r0_x);
    r0_y = floor(r0_y);
    r0_z = floor(r0_z);
    r0_w = floor(r0_w);
    hr0_x = r0_x * 0.003921568859368563;
    hr0_y = r0_y * 0.003921568859368563;
    hr0_z = r0_z * 0.003921568859368563;
    hr0_w = r0_w * 0.003921568859368563;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
