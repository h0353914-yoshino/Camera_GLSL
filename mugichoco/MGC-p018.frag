#version 100
#extension GL_OES_EGL_image_external : require
precision highp float;

uniform highp samplerExternalOES texUnit0;
uniform highp float pixSize;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample10;
    highp vec4 sample12;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_x;
    pixSize;
    r0_z = pixSize;
    r0_w = texCoord.x;
    r1_x = texCoord.y;
    r0_x = 0.0;
    r0_y = (-0.5) * r0_z + r0_w;
    r1_y = r1_x;
    r0_z = 0.5 * r0_z + r0_w;
    r0_w = r1_x + 0.0;
    r1_x = r0_y;
    r0_x = 0.0;
    sample10 = texture2D(texUnit0, vec2(r0_z, r0_w));
    r1_z = sample10.x;
    r1_w = sample10.y;
    r2_x = sample10.z;
    r2_y = sample10.w;
    sample12 = texture2D(texUnit0, vec2(r1_x, r1_y));
    r0_y = sample12.x;
    r0_z = sample12.y;
    r0_w = sample12.z;
    r1_x = sample12.w;
    r1_y = 0.0 * r2_y;
    r2_z = 0.0 * r2_y;
    r2_y = 0.0 * r2_y;
    r2_w = 0.0 * r1_x;
    r3_x = 0.0 * r1_x;
    r1_x = 0.0 * r1_x;
    r1_y = 0.0 * r2_x + r1_y;
    r2_z = 0.0 * r2_x + r2_z;
    r2_x = 0.0 * r2_x + r2_y;
    r2_w = 0.0 * r0_w + r2_w;
    r3_x = 0.0 * r0_w + r3_x;
    r0_w = 0.0 * r0_w + r1_x;
    r1_x = 0.0 * r1_w + r1_y;
    r1_y = 0.0 * r1_w + r2_z;
    r2_x = 0.0 * r1_w + r2_x;
    r2_y = 0.0 * r0_z + r2_w;
    r2_z = 0.0 * r0_z + r3_x;
    r0_w = 0.0 * r0_z + r0_w;
    r1_x = 0.0 * r1_z + r1_x;
    r1_y = 0.0 * r1_z + r1_y;
    r2_x = 0.0 * r1_z + r2_x;
    r2_x = 0.0 * r0_y + r2_y;
    r2_y = 0.0 * r0_y + r2_z;
    r0_w = 0.0 * r0_y + r0_w;
    r0_w = (r0_x != 0.0) ? r1_x : r1_z;
    r0_y = (r0_x != 0.0) ? r2_x : r0_y;
    r0_z = (r0_x != 0.0) ? r2_y : r0_z;
    r0_x = (r0_x != 0.0) ? r1_y : r1_w;
    hr0_z = r0_w;
    hr0_x = r0_y;
    hr0_y = r0_z;
    hr0_w = r0_x;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
