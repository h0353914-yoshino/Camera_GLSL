#version 300 es
#extension GL_OES_EGL_image_external_essl3 : require
precision highp int;
precision highp float;

uniform highp samplerExternalOES texUnit;
uniform highp vec4 translateParam;
uniform highp mat2 rotationParam;
uniform highp vec4 pixSize;
in highp vec2 texCoord;
out mediump vec4 fragColor;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample48;
    highp vec4 sample53;
    highp vec4 sample55;
    highp vec4 sample59;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_x;
    highp float r4_y;
    highp float r4_z;
    translateParam;
    rotationParam;
    pixSize;
    r0_z = texCoord.x;
    r0_w = texCoord.y;
    r0_x = 0.0;
    r0_y = 2.0 * r0_w + 0.5;
    r0_z = 2.0 * r0_z + 0.5;
    r0_x = 0.0;
    r0_y = floor(r0_y);
    r0_z = floor(r0_z);
    hr0_x = r0_x;
    r0_x = 0.5 * r0_y + 0.0;
    r0_w = 0.5 * r0_z + -1.5;
    r1_x = 0.5 * r0_z + -0.5;
    r1_y = 0.5 * r0_z + 0.5;
    r0_y = 0.5 * r0_y + (-translateParam.w);
    r0_x = r0_x - translateParam.w;
    r0_w = r0_w - translateParam.z;
    r1_x = r1_x - translateParam.z;
    r1_y = r1_y - translateParam.z;
    r1_z = rotationParam[1][0] * r0_y;
    r0_y = rotationParam[1][1] * r0_y;
    r1_w = rotationParam[1][0] * r0_x;
    r0_x = rotationParam[1][1] * r0_x;
    r2_x = rotationParam[0][0] * r0_w + r1_z;
    r0_w = rotationParam[0][1] * r0_w + r0_y;
    r1_z = rotationParam[0][0] * r1_x + r1_z;
    r0_y = rotationParam[0][1] * r1_x + r0_y;
    r1_x = rotationParam[0][0] * r1_y + r1_w;
    r1_y = rotationParam[0][1] * r1_y + r0_x;
    r0_z = 0.5 * r0_z + 1.5;
    r2_x = r2_x + translateParam.x;
    r0_w = r0_w + translateParam.y;
    r1_z = r1_z + translateParam.x;
    r0_y = r0_y + translateParam.y;
    r1_x = r1_x + translateParam.x;
    r1_y = r1_y + translateParam.y;
    r0_z = r0_z - translateParam.z;
    r2_x = r2_x + translateParam.z;
    r0_w = r0_w + translateParam.w;
    r1_z = r1_z + translateParam.z;
    r2_y = r0_y + translateParam.w;
    r1_x = r1_x + translateParam.z;
    r1_y = r1_y + translateParam.w;
    r1_w = rotationParam[0][0] * r0_z + r1_w;
    r2_z = rotationParam[0][1] * r0_z + r0_x;
    r0_x = r2_x * pixSize.x;
    r0_y = r0_w * pixSize.y;
    r0_z = r1_z * pixSize.x;
    r0_w = r2_y * pixSize.y;
    r1_x = r1_x * pixSize.x;
    r1_y = r1_y * pixSize.y;
    r2_w = r1_w + translateParam.x;
    r2_z = r2_z + translateParam.y;
    sample48 = texture(texUnit, vec2(r0_x, r0_y));
    r1_z = sample48.x;
    r1_w = sample48.y;
    r2_x = sample48.z;
    r2_y = sample48.w;
    r4_z = hr0_x;
    r3_z = r2_w + translateParam.z;
    r3_w = r2_z + translateParam.w;
    sample53 = texture(texUnit, vec2(r0_z, r0_w));
    r0_x = sample53.x;
    r0_y = sample53.y;
    r0_z = sample53.z;
    r0_w = sample53.w;
    sample55 = texture(texUnit, vec2(r1_x, r1_y));
    r2_z = sample55.x;
    r2_w = sample55.y;
    r3_x = sample55.z;
    r3_y = sample55.w;
    r1_x = r3_z * pixSize.x;
    r1_y = r3_w * pixSize.y;
    hr0_x = float(int(hr0_x) & int(1.0));
    p0 = hr0_x == 1.0;
    sample59 = texture(texUnit, vec2(r1_x, r1_y));
    r3_z = sample59.x;
    r3_w = sample59.y;
    r4_x = sample59.z;
    r4_y = sample59.w;
    r1_x = 0.0 * r2_y;
    r1_x = 0.0 * r2_x + r1_x;
    r0_w = 0.0 * r0_w;
    r1_y = 0.0 * r3_y;
    r0_z = 0.0 * r0_z + r0_w;
    r0_w = 0.0 * r3_x + r1_y;
    r1_x = 0.0 * r1_w + r1_x;
    r0_z = 0.0 * r0_y + r0_z;
    r0_w = 0.0 * r2_w + r0_w;
    r1_x = 0.0 * r1_z + r1_x;
    r0_x = 0.0 * r0_x + r0_z;
    r0_z = 0.0 * r2_z + r0_w;
    r0_w = (r4_z != 0.0) ? r1_x : r1_w;
    r0_x = (r4_z != 0.0) ? r0_x : r0_y;
    r0_y = (r4_z != 0.0) ? r0_z : r2_w;
    if (p0)
    {
        r0_z = 0.0 * r4_y;
        r0_z = 0.0 * r4_x + r0_z;
        r0_z = 0.0 * r3_w + r0_z;
        r3_w = 0.0 * r3_z + r0_z;
    }
    r0_z = 255.0 * r0_w + 0.5;
    r0_x = 255.0 * r0_x + 0.5;
    r0_y = 255.0 * r0_y + 0.5;
    r0_w = 255.0 * r3_w + 0.5;
    r0_z = floor(r0_z);
    r0_x = floor(r0_x);
    r0_y = floor(r0_y);
    r0_w = floor(r0_w);
    hr0_x = r0_z * 0.003921568859368563;
    hr0_y = r0_x * 0.003921568859368563;
    hr0_z = r0_y * 0.003921568859368563;
    hr0_w = r0_w * 0.003921568859368563;
    fragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
