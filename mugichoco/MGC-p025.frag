#version 100
#extension GL_OES_EGL_image_external : require
precision highp float;

uniform highp samplerExternalOES texUnitImage;
uniform highp sampler2D texUnitVec;
uniform highp vec2 pixSize;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample18;
    highp vec4 sample20;
    highp vec4 sample23;
    highp vec4 sample27;
    highp vec4 sample76;
    highp vec4 sample77;
    highp vec4 sample78;
    highp vec4 sample84;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_w;
    highp float r4_x;
    highp float r4_y;
    highp float r4_z;
    highp float r5_w;
    highp float r5_x;
    highp float r5_y;
    highp float r5_z;
    highp float r6_w;
    highp float r6_x;
    highp float r6_y;
    highp float r6_z;
    highp float r7_x;
    pixSize;
    r1_z = texCoord.x;
    r4_x = texCoord.y;
    r1_w = pixSize.x;
    r2_x = 0.0;
    r4_y = r4_x + 0.0;
    r0_y = r4_x;
    r4_z = (-1.5) * r1_w + r1_z;
    r4_w = (-0.5) * r1_w + r1_z;
    r5_x = 0.5 * r1_w + r1_z;
    r0_w = r4_x;
    r0_x = r4_z;
    r0_z = r4_w;
    r1_x = r5_x;
    r1_y = r4_y;
    r5_y = 1.5 * r1_w + r1_z;
    r1_w = r4_y;
    r5_z = 0.0;
    sample18 = texture2D(texUnitVec, vec2(r0_x, r0_y));
    r2_x = sample18.x;
    r2_y = sample18.y;
    r2_z = sample18.z;
    r2_w = sample18.w;
    sample20 = texture2D(texUnitVec, vec2(r0_z, r0_w));
    r0_x = sample20.x;
    r0_y = sample20.y;
    r0_z = sample20.z;
    r0_w = sample20.w;
    r1_z = r5_y;
    sample23 = texture2D(texUnitVec, vec2(r1_x, r1_y));
    r3_x = sample23.x;
    r3_y = sample23.y;
    r3_z = sample23.z;
    r3_w = sample23.w;
    hr0_x = r5_z;
    r5_z = hr0_x;
    sample27 = texture2D(texUnitVec, vec2(r1_z, r1_w));
    r1_x = sample27.x;
    r1_y = sample27.y;
    r1_z = sample27.z;
    r1_w = sample27.w;
    hr0_x = hr0_x;
    p0 = hr0_x == 1.0;
    r2_y = r2_y * 255.0;
    r2_w = r2_w * 255.0;
    r0_y = r0_y * 255.0;
    r0_w = r0_w * 255.0;
    r3_y = r3_y * 255.0;
    r3_w = r3_w * 255.0;
    r5_w = (r2_y < 128.0) ? 1.0 : 0.0;
    r6_x = (r2_w < 128.0) ? 1.0 : 0.0;
    r6_y = (r0_y < 128.0) ? 1.0 : 0.0;
    r6_z = (r0_w < 128.0) ? 1.0 : 0.0;
    r6_w = (r3_y < 128.0) ? 1.0 : 0.0;
    r7_x = (r3_w < 128.0) ? 1.0 : 0.0;
    r2_y = r2_y * 256.0;
    r2_w = r2_w * 256.0;
    r0_y = r0_y * 256.0;
    r0_w = r0_w * 256.0;
    r3_y = r3_y * 256.0;
    r3_w = r3_w * 256.0;
    r2_x = 255.0 * r2_x + r2_y;
    r2_y = 255.0 * r2_z + r2_w;
    r2_z = (r5_w != 0.0) ? 0.0 : 65536.0;
    r2_w = (r6_x != 0.0) ? 0.0 : 65536.0;
    r0_x = 255.0 * r0_x + r0_y;
    r0_y = 255.0 * r0_z + r0_w;
    r0_z = (r6_y != 0.0) ? 0.0 : 65536.0;
    r0_w = (r6_z != 0.0) ? 0.0 : 65536.0;
    r3_x = 255.0 * r3_x + r3_y;
    r3_y = 255.0 * r3_z + r3_w;
    r3_z = (r6_w != 0.0) ? 0.0 : 65536.0;
    r3_w = (r7_x != 0.0) ? 0.0 : 65536.0;
    r2_x = r2_x - r2_z;
    r2_y = r2_y - r2_w;
    r0_z = r0_x - r0_z;
    r0_w = r0_y - r0_w;
    r2_z = r3_x - r3_z;
    r2_w = r3_y - r3_w;
    r1_y = r1_y * 255.0;
    r3_x = r1_w * 255.0;
    r0_x = pixSize.x * r2_x + r4_z;
    r0_y = pixSize.y * r2_y + r4_x;
    r0_z = pixSize.x * r0_z + r4_w;
    r0_w = pixSize.y * r0_w + r4_x;
    r1_w = pixSize.x * r2_z + r5_x;
    r2_x = pixSize.y * r2_w + r4_y;
    r2_y = (r1_y < 128.0) ? 1.0 : 0.0;
    r2_z = (r3_x < 128.0) ? 1.0 : 0.0;
    r1_y = r1_y * 256.0;
    r2_w = r3_x * 256.0;
    r3_y = 255.0 * r1_x + r1_y;
    r3_z = 255.0 * r1_z + r2_w;
    r3_w = (r2_y != 0.0) ? 0.0 : 65536.0;
    r4_x = (r2_z != 0.0) ? 0.0 : 65536.0;
    sample76 = texture2D(texUnitImage, vec2(r0_x, r0_y));
    r2_y = sample76.x;
    r2_z = sample76.y;
    r2_w = sample76.z;
    r3_x = sample76.w;
    sample77 = texture2D(texUnitImage, vec2(r0_z, r0_w));
    r0_x = sample77.x;
    r0_y = sample77.y;
    r0_z = sample77.z;
    r0_w = sample77.w;
    sample78 = texture2D(texUnitImage, vec2(r1_w, r2_x));
    r1_x = sample78.x;
    r1_y = sample78.y;
    r1_z = sample78.z;
    r1_w = sample78.w;
    r2_x = r3_y - r3_w;
    r3_z = r3_z - r4_x;
    r3_y = pixSize.x * r2_x + r5_y;
    r3_z = pixSize.y * r3_z + r4_y;
    sample84 = texture2D(texUnitImage, vec2(r3_y, r3_z));
    r3_y = sample84.x;
    r3_z = sample84.y;
    r3_w = sample84.z;
    r4_x = sample84.w;
    r2_x = 0.0 * r3_x;
    r0_w = 0.0 * r0_w;
    r1_w = 0.0 * r1_w;
    r2_x = 0.0 * r2_w + r2_x;
    r0_z = 0.0 * r0_z + r0_w;
    r0_w = 0.0 * r1_z + r1_w;
    r1_z = 0.0 * r2_z + r2_x;
    r0_y = 0.0 * r0_y + r0_z;
    r0_z = 0.0 * r1_y + r0_w;
    r0_w = 0.0 * r2_y + r1_z;
    r0_y = 0.0 * r0_x + r0_y;
    r0_z = 0.0 * r1_x + r0_z;
    r0_w = (r5_z != 0.0) ? r0_w : r2_y;
    r0_x = (r5_z != 0.0) ? r0_y : r0_x;
    r0_y = (r5_z != 0.0) ? r0_z : r1_x;
    hr0_x = r0_w;
    hr0_y = r0_x;
    hr0_z = r0_y;
    if (p0)
    {
        r0_x = 0.0 * r4_x;
        r0_x = 0.0 * r3_w + r0_x;
        r0_x = 0.0 * r3_z + r0_x;
        r3_y = 0.0 * r3_y + r0_x;
    }
    hr0_w = r3_y;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
