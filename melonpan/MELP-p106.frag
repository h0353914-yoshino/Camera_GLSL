#version 100
precision highp float;

uniform highp sampler2D texUnit0;
uniform highp sampler2D texUnitHist;
uniform highp vec2 pixSize;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample10;
    highp vec4 sample26;
    highp vec4 sample27;
    highp vec4 sample28;
    highp vec4 sample30;
    highp vec4 samplePF0;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    pixSize;
    samplePF0 = texture2D(texUnit0, texCoord.xy);
    r0_z = samplePF0.y;
    r0_w = samplePF0.z;
    r1_x = samplePF0.w;
    r1_y = texCoord.x;
    r1_z = texCoord.y;
    r0_y = 0.5;
    r1_w = 0.5;
    r0_x = r1_y + pixSize.x;
    r2_y = 0.5;
    r1_y = r0_x;
    r2_w = 0.5;
    sample10 = texture2D(texUnit0, vec2(r1_y, r1_z));
    r0_x = sample10.x;
    r0_z = 255.0 * r0_z + 0.5;
    r0_w = 255.0 * r0_w + 0.5;
    r1_x = 255.0 * r1_x + 0.5;
    r0_z = floor(r0_z);
    r0_w = floor(r0_w);
    r1_x = floor(r1_x);
    r0_x = 255.0 * r0_x + 0.5;
    r0_z = r0_z + 0.5;
    r0_w = r0_w + 0.5;
    r1_x = r1_x + 0.5;
    r0_x = floor(r0_x);
    r0_z = r0_z * 0.00390625;
    r1_z = r0_w * 0.00390625;
    r2_x = r1_x * 0.00390625;
    r0_w = r0_x + 0.5;
    r0_x = r0_z;
    r2_z = r0_w * 0.00390625;
    sample26 = texture2D(texUnitHist, vec2(r0_x, r0_y));
    r0_x = sample26.x;
    sample27 = texture2D(texUnitHist, vec2(r1_z, r1_w));
    r0_y = sample27.x;
    sample28 = texture2D(texUnitHist, vec2(r2_x, r2_y));
    r0_z = sample28.x;
    sample30 = texture2D(texUnitHist, vec2(r2_z, r2_w));
    r0_w = sample30.x;
    hr0_x = r0_x * 0.003921568859368563;
    hr0_y = r0_y * 0.003921568859368563;
    hr0_z = r0_z * 0.003921568859368563;
    hr0_w = r0_w * 0.003921568859368563;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
