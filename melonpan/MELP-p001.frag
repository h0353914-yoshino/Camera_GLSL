#version 100
precision highp float;

uniform highp sampler2D texUnit0;
uniform highp vec2 pixSize;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample20;
    highp vec4 sample21;
    highp vec4 sample23;
    highp vec4 sample24;
    highp vec4 sample26;
    highp vec4 sample28;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
