#version 100
#extension GL_OES_EGL_image_external : require
precision highp float;

uniform highp samplerExternalOES texUnit0;
uniform highp sampler2D texUnitHist;
uniform highp vec2 pixSize;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample12;
    highp vec4 sample33;
    highp vec4 sample50;
    highp vec4 sample51;
    highp vec4 sample53;
    highp vec4 samplePF0;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    pixSize;
    samplePF0 = texture2D(texUnit0, texCoord.xy);
    r0_z = samplePF0.x;
    r0_w = samplePF0.y;
    r1_x = samplePF0.z;
    r1_y = samplePF0.w;
    r0_z = texCoord.x;
    r0_w = texCoord.y;
    r0_y = 0.5;
    r1_x = 0.5;
    r0_x = r0_z + pixSize.x;
    r1_z = 0.5;
    r0_z = r0_x;
    r2_x = 0.5;
    r0_x = 0.0;
    r1_w = 0.0;
    sample12 = texture2D(texUnit0, vec2(r0_z, r0_w));
    r2_y = sample12.x;
    r2_z = sample12.y;
    r2_w = sample12.z;
    r3_x = sample12.w;
    r0_x = (r1_w != 0.0) ? 1.0 : r1_y;
    r0_x = 255.0 * r0_x + 0.5;
    r0_z = 0.0 * r3_x;
    r0_w = 0.0 * r3_x;
    r1_y = 0.0 * r3_x;
    r3_x = floor(r0_x);
    r0_z = 0.0 * r2_w + r0_z;
    r0_w = 0.0 * r2_w + r0_w;
    r0_x = 0.0 * r2_w + r1_y;
    r1_y = r3_x + 0.5;
    r0_z = 0.0 * r2_z + r0_z;
    r0_w = 0.0 * r2_z + r0_w;
    r0_x = 0.0 * r2_z + r0_x;
    r1_y = r1_y * 0.00390625;
    r0_z = 0.0 * r2_y + r0_z;
    r0_w = 0.0 * r2_y + r0_w;
    r3_y = 0.0 * r2_y + r0_x;
    r0_x = r1_y;
    r0_z = (r1_w != 0.0) ? r0_z : r2_y;
    r0_w = (r1_w != 0.0) ? r0_w : r2_z;
    r1_y = (r1_w != 0.0) ? r3_y : r2_w;
    r1_w = (r3_x < 240.0) ? 1.0 : 0.0;
    r0_z = 255.0 * r0_z + 0.5;
    r0_w = 255.0 * r0_w + 0.5;
    r1_y = 255.0 * r1_y + 0.5;
    sample33 = texture2D(texUnitHist, vec2(r0_x, r0_y));
    r0_x = sample33.x;
    r0_y = floor(r0_z);
    r0_z = floor(r0_w);
    r2_y = floor(r1_y);
    r2_z = (r1_w != 0.0) ? 0.0 : 1.0;
    r0_w = r0_y + 0.5;
    r1_y = r0_z + 0.5;
    r1_w = r2_y + 0.5;
    r2_w = (r0_y < 240.0) ? 1.0 : 0.0;
    r0_w = r0_w * 0.00390625;
    r1_y = r1_y * 0.00390625;
    r1_w = r1_w * 0.00390625;
    r3_y = (r0_z < 240.0) ? 1.0 : 0.0;
    r3_z = (r2_y < 240.0) ? 1.0 : 0.0;
    r2_w = (r2_w != 0.0) ? 0.0 : 1.0;
    r3_y = (r3_y != 0.0) ? 0.0 : 1.0;
    sample50 = texture2D(texUnitHist, vec2(r0_w, r1_x));
    r0_w = sample50.x;
    sample51 = texture2D(texUnitHist, vec2(r1_y, r1_z));
    r1_x = sample51.x;
    sample53 = texture2D(texUnitHist, vec2(r1_w, r2_x));
    r1_y = sample53.x;
    r1_z = (r3_z != 0.0) ? 0.0 : 1.0;
    r1_w = 1.0 - r2_z;
    r2_x = 1.0 - r2_w;
    r2_z = 1.0 - r3_y;
    r1_z = 1.0 - r1_z;
    r2_w = 1.0 - r1_w;
    r3_y = 1.0 - r2_x;
    r3_z = 1.0 - r2_z;
    r3_w = 1.0 - r1_z;
    r0_x = r0_x * r1_w;
    r0_x = r2_w * r3_x + r0_x;
    r0_w = r0_w * r2_x;
    r1_x = r1_x * r2_z;
    r1_y = r1_y * r1_z;
    r0_y = r0_y * r3_y + r0_w;
    r0_z = r0_z * r3_z + r1_x;
    r0_w = r2_y * r3_w + r1_y;
    hr0_x = r0_x * 0.003921568859368563;
    hr0_y = r0_y * 0.003921568859368563;
    hr0_z = r0_z * 0.003921568859368563;
    hr0_w = r0_w * 0.003921568859368563;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
