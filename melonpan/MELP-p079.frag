#version 300 es
precision highp int;
precision highp float;

uniform highp usampler2D sadImage;
uniform highp sampler2D btmMaskImage;
uniform highp vec2 dstPixSize;
uniform highp vec4 params;
uniform highp vec2 sadPixSize;
uniform highp vec2 btmMaskPixSize;
in highp vec2 texCoord;
out highp vec4 fragColor;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample46;
    highp vec4 sample47;
    highp vec4 sample49;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_x;
    highp float r4_y;
    highp float r4_z;
    dstPixSize;
    params;
    sadPixSize;
    btmMaskPixSize;
    r0_z = texCoord.x;
    r0_w = texCoord.y;
    r3_y = float(int(params.x));
    r3_z = float(int(params.y));
    p0 = r3_y < r3_z;
    if (!p0)
    {
        r4_y = 65535.0;
    }
    else
    {
        r0_x = dstPixSize.y;
        r0_y = dstPixSize.x;
        r1_x = params.z;
        r0_x = 1.0 / r0_x;
        r0_y = 1.0 / r0_y;
        r3_w = 1.0 / r1_x;
        r0_x = r0_x * r0_w;
        r0_y = r0_y * r0_z;
        r0_x = floor(r0_x);
        r0_y = r0_y - 0.5;
        r0_x = r0_x * params.w;
        r0_x = 4.0 * r0_y + r0_x;
        r0_x = r0_x + 0.5;
        r0_x = r0_x + 0.0;
        r0_w = r0_x * sadPixSize.y;
        r1_y = r0_x * btmMaskPixSize.y;
        r0_y = r0_w;
        r4_y = 65535.0;
        r4_x = 65535.0;
        while (true)
        {
            r0_x = r3_y;
            r3_y = r3_y + 1.0;
            r0_z = r0_x + 0.5;
            r1_x = r0_x - 1.0;
            r1_z = r0_x * r3_w;
            p0 = r3_y < r3_z;
            r1_w = r0_z * sadPixSize.x;
            r2_x = r0_z * btmMaskPixSize.x;
            r2_y = r1_x + 0.5;
            r1_z = floor(r1_z);
            r0_z = r1_w;
            r1_x = r2_x;
            r1_w = r2_y * sadPixSize.x;
            r4_z = (-params.z) * r1_z + r0_x;
            r0_x = r1_w;
            sample46 = vec4(texture(sadImage, vec2(r0_z, r0_w)));
            r1_z = sample46.x;
            r1_w = sample46.y;
            r2_x = sample46.z;
            sample47 = texture(btmMaskImage, vec2(r1_x, r1_y));
            r2_y = sample47.x;
            r2_z = sample47.y;
            r2_w = sample47.z;
            r3_x = sample47.w;
            r0_z = (r4_z < 0.5) ? 1.0 : 0.0;
            sample49 = vec4(texture(sadImage, vec2(r0_x, r0_y)));
            r1_x = sample49.w;
            r0_x = (r0_z != 0.0) ? 0.0 : 1.0;
            r0_z = r2_x;
            r2_x = r2_w * 255.0;
            r2_w = r3_x * 255.0;
            r1_z = r1_z;
            r3_x = (r0_z < r4_x) ? 1.0 : 0.0;
            r2_y = r2_y * 255.0;
            r1_x = r1_x;
            r2_w = r0_x * r2_w;
            r3_x = (r3_x != 0.0) ? 0.0 : 1.0;
            r0_x = r0_x * r2_y;
            r1_w = r1_w;
            r2_y = r2_z * 255.0;
            r2_z = 1.0 - r3_x;
            r3_x = r2_x * r2_z;
            r2_z = (-r2_x) * r2_z + 1.0;
            r4_z = r3_x * r4_x;
            r3_x = r0_z * r3_x;
            r4_y = r2_z * r4_y + r4_z;
            r3_x = r2_z * r4_x + r3_x;
            r2_x = r2_x * r2_z;
            r2_z = (r0_z < r4_y) ? 1.0 : 0.0;
            r4_x = (r0_z < r3_x) ? 1.0 : 0.0;
            r4_z = (r1_x < r3_x) ? 1.0 : 0.0;
            r2_z = (r2_z != 0.0) ? 0.0 : 1.0;
            r4_x = (r4_x != 0.0) ? 0.0 : 1.0;
            r4_z = (r4_z != 0.0) ? 0.0 : 1.0;
            r2_z = 1.0 - r2_z;
            r2_x = r2_x * r4_x;
            r4_x = 1.0 - r4_z;
            r4_z = r2_x * r2_z;
            r2_x = (-r2_x) * r2_z + 1.0;
            r2_z = r2_w * r4_x;
            r4_x = (-r2_w) * r4_x + 1.0;
            r0_z = r0_z * r4_z;
            r0_z = r2_x * r4_y + r0_z;
            r2_x = r2_z * r3_x;
            r2_z = r1_x * r2_z;
            r2_w = r2_w * r4_x;
            r2_z = r3_x * r4_x + r2_z;
            r0_z = r0_z * r4_x + r2_x;
            r2_x = (r1_x < r2_z) ? 1.0 : 0.0;
            r3_x = (r1_x < r0_z) ? 1.0 : 0.0;
            r4_x = (r1_z < r2_z) ? 1.0 : 0.0;
            r2_x = (r2_x != 0.0) ? 0.0 : 1.0;
            r3_x = (r3_x != 0.0) ? 0.0 : 1.0;
            r4_x = (r4_x != 0.0) ? 0.0 : 1.0;
            r2_x = r2_x * r2_w;
            r2_w = 1.0 - r3_x;
            r3_x = 1.0 - r4_x;
            r4_x = r2_x * r2_w;
            r2_x = (-r2_x) * r2_w + 1.0;
            r2_w = r0_x * r3_x;
            r3_x = (-r0_x) * r3_x + 1.0;
            r1_x = r1_x * r4_x;
            r0_z = r0_z * r2_x + r1_x;
            r1_x = r2_z * r2_w;
            r2_x = r1_z * r2_w;
            r0_x = r0_x * r3_x;
            r2_x = r2_z * r3_x + r2_x;
            r0_z = r0_z * r3_x + r1_x;
            r1_x = (r1_z < r2_x) ? 1.0 : 0.0;
            r2_z = (r1_z < r0_z) ? 1.0 : 0.0;
            r2_w = (r1_w < r2_x) ? 1.0 : 0.0;
            r1_x = (r1_x != 0.0) ? 0.0 : 1.0;
            r2_z = (r2_z != 0.0) ? 0.0 : 1.0;
            r2_w = (r2_w != 0.0) ? 0.0 : 1.0;
            r0_x = r0_x * r1_x;
            r1_x = 1.0 - r2_z;
            r2_z = 1.0 - r2_w;
            r2_w = r0_x * r1_x;
            r0_x = (-r0_x) * r1_x + 1.0;
            r1_x = r2_y * r2_z;
            r2_z = (-r2_y) * r2_z + 1.0;
            r1_z = r1_z * r2_w;
            r0_x = r0_x * r0_z + r1_z;
            r0_z = r1_x * r2_x;
            r1_x = r1_x * r1_w;
            r1_z = r2_y * r2_z;
            r0_x = r0_x * r2_z + r0_z;
            r4_x = r2_x * r2_z + r1_x;
            r0_z = (r1_w < r0_x) ? 1.0 : 0.0;
            r1_x = (r1_w < r4_x) ? 1.0 : 0.0;
            r0_z = (r0_z != 0.0) ? 0.0 : 1.0;
            r1_x = (r1_x != 0.0) ? 0.0 : 1.0;
            r0_z = 1.0 - r0_z;
            r1_x = r1_x * r1_z;
            r1_z = r0_z * r1_x;
            r0_z = r0_z * (-r1_x) + 1.0;
            r1_x = r1_z * r1_w;
            r4_y = r0_x * r0_z + r1_x;
            if (!(p0)) break;
        }
    }
    r0_x = float(int(r4_y));
    r0_y = 0.0;
    r0_z = 0.0;
    r0_w = 0.0;
    fragColor = vec4(r0_x, r0_y, r0_z, r0_w);
}
