void main()
{
    bool p0;
    bool p1;
    highp vec4 sample55;
    highp vec4 sample57;
    highp vec4 sample58;
    highp vec4 sample59;
    highp vec4 sample61;
    highp vec4 sample63;
    mediump float hr0_w;
