    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_w;
    highp float r4_x;
    highp float r4_y;
    highp float r4_z;
    highp float r5_w;
    highp float r5_x;
    highp float r5_y;
    highp float r5_z;
    highp float r6_w;
    highp float r6_x;
    highp float r6_y;
    highp float r6_z;
    highp float r7_w;
    highp float r7_x;
    highp float r7_y;
    highp float r7_z;
    highp float r8_x;
    highp float r8_y;
    dstPixSize;
    params;
    offset;
    tarPixSize;
    refPixSize;
    r0_z = dstPixSize.y;
    r0_w = params.x;
    r1_x = dstPixSize.x;
    r1_y = texCoord.x;
    r1_z = texCoord.y;
    r0_x = params.y;
    r0_y = dstPixSize.y * r0_w;
    r0_z = 1.0 / r0_z;
    r0_w = 1.0 / r0_w;
    r1_x = 1.0 / r1_x;
    hr0_x = tarPixSize.x;
    hr0_y = refPixSize.x;
    r0_x = 1.0 / r0_x;
    r0_y = 1.0 / r0_y;
    r1_w = hr0_x * 0.0;
    r7_x = 0.0;
    hr0_z = 0.0;
    r0_z = r0_z * r1_z;
    r1_x = r1_x * r1_y;
    r0_w = r0_z * r0_w;
    r0_x = r0_x * r1_x;
    r0_y = r0_y * r1_z;
    r0_w = floor(r0_w);
    r0_x = floor(r0_x);
    r0_y = floor(r0_y);
    r0_z = (-params.x) * r0_w + r0_z;
    r0_w = r0_x + 0.5;
    r0_x = (-params.y) * r0_x + r1_x;
    r0_z = floor(r0_z);
    r0_w = params.w * r0_y + r0_w;
    r7_y = params.w * r0_y + offset.y;
    r7_z = params.z * r0_z + offset.x;
    r0_x = params.z * r0_z + r0_x;
    r0_y = tarPixSize.x * r7_z + r1_w;
    r7_w = r0_x + offset.z;
    r8_x = r0_w + offset.w;
    r0_x = r0_y;
    r8_y = r7_x;
    while (true)
    {
        hr0_w = hr0_z;
        r0_y = hr0_y * 0.0;
