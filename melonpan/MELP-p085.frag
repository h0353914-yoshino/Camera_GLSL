        sample61 = texture(tarImage, vec2(r0_x, r0_y));
        r6_x = sample61.x;
        r6_y = sample61.y;
        r6_z = sample61.z;
        r6_w = sample61.w;
        sample63 = texture(tarImage, vec2(r1_x, r1_y));
        r0_y = sample63.x;
        r0_z = sample63.y;
        r0_w = sample63.z;
        r1_x = sample63.w;
        p0 = hr0_z < 8.0;
        r1_w = r2_y * 255.0;
        r2_y = r3_y * 255.0;
        r1_y = r4_x * 255.0;
        r1_z = r4_y * 255.0;
        r3_y = r4_z * 255.0;
        r4_x = r4_w * 255.0;
        r3_x = r3_x * 255.0;
        r4_y = 255.0 * r6_y + (-r1_z);
        r4_z = 255.0 * r6_x + (-r1_y);
        r2_y = 255.0 * r6_y + (-r2_y);
        r3_x = 255.0 * r6_x + (-r3_x);
        r1_y = r5_x * 255.0;
        r1_z = r5_y * 255.0;
        r4_w = r5_z * 255.0;
        r5_x = r5_w * 255.0;
        r3_z = r3_z * 255.0;
        r2_x = r2_x * 255.0;
        r3_y = 255.0 * r6_z + (-r3_y);
        r3_z = 255.0 * r6_z + (-r3_z);
        r4_y = abs(r4_y) + abs(r4_z);
        r2_y = abs(r2_y) + abs(r3_x);
        r1_z = 255.0 * r0_z + (-r1_z);
        r1_y = 255.0 * r0_y + (-r1_y);
        r0_z = 255.0 * r0_z + (-r1_w);
        r0_y = 255.0 * r0_y + (-r2_x);
        r1_w = r3_w * 255.0;
        r2_x = r2_z * 255.0;
        r2_z = 255.0 * r6_w + (-r4_x);
        r1_w = 255.0 * r6_w + (-r1_w);
        r3_x = abs(r3_y) + r4_y;
        r2_y = r2_y + abs(r3_z);
        r3_y = 255.0 * r0_w + (-r4_w);
        r0_w = 255.0 * r0_w + (-r2_x);
        r1_y = abs(r1_y) + abs(r1_z);
        r0_y = abs(r0_y) + abs(r0_z);
        r0_z = r2_w * 255.0;
        r1_z = abs(r2_z) + r3_x;
        r1_w = abs(r1_w) + r2_y;
        r2_x = 255.0 * r1_x + (-r5_x);
        r0_z = 255.0 * r1_x + (-r0_z);
        r1_x = r1_y + abs(r3_y);
        r0_y = r0_y + abs(r0_w);
        r0_w = r1_z + r8_y;
        r1_y = r1_w + r7_x;
        r1_x = r1_x + abs(r2_x);
        r0_y = r0_y + abs(r0_z);
        r0_z = r0_w + r1_x;
        r7_x = r0_y + r1_y;
        if (!p0) break;
        r8_y = r0_z;
    }
    r0_x = r7_x * 0.00390625;
    r0_y = r0_z * 0.00390625;
    r0_z = floor(r0_x);
    r0_w = floor(r0_y);
    r1_x = r0_x - r0_z;
    r0_y = r0_y - r0_w;
    r0_x = r0_z * 0.003921568859368563;
    r0_z = r0_w * 0.003921568859368563;
    r0_w = r1_x * 256.0;
    r0_y = r0_y * 256.0;
    r0_w = floor(r0_w);
    r1_x = floor(r0_y);
    r0_y = r0_w * 0.003921568859368563;
    r0_w = r1_x * 0.003921568859368563;
    fragColor = vec4(r0_x, r0_y, r0_z, r0_w);
