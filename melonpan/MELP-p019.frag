#version 100
precision highp float;

uniform highp sampler2D texUnit0;
uniform highp vec2 pixSize;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample15;
    highp vec4 sample17;
    highp vec4 sample19;
    highp vec4 sample21;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_x;
    highp float r4_y;
    pixSize;
    hr0_x = pixSize.y;
    r0_z = texCoord.x;
    r0_w = texCoord.y;
    r0_x = pixSize.x;
    r0_y = hr0_x * (-0.5);
    r1_x = hr0_x * 0.5;
    r1_y = -0.5 * r0_x + r0_z;
    r0_x = 0.5 * r0_x + r0_z;
    r0_z = r0_y + r0_w;
    r0_y = r0_w + r1_x;
    r0_w = r1_y;
    r1_z = r0_x;
    r1_x = r0_z;
    r1_w = r0_z;
    r2_x = r1_y;
    r2_y = r0_y;
    sample15 = texture2D(texUnit0, vec2(r0_x, r0_y));
    r2_z = sample15.x;
    r2_w = sample15.y;
    r3_x = sample15.z;
    r3_y = sample15.w;
    sample17 = texture2D(texUnit0, vec2(r0_w, r1_x));
    r0_x = sample17.x;
    r0_y = sample17.y;
    r0_z = sample17.z;
    r0_w = sample17.w;
    sample19 = texture2D(texUnit0, vec2(r1_z, r1_w));
    r1_x = sample19.x;
    r1_y = sample19.y;
    r1_z = sample19.z;
    r1_w = sample19.w;
    sample21 = texture2D(texUnit0, vec2(r2_x, r2_y));
    r3_z = sample21.x;
    r3_w = sample21.y;
    r4_x = sample21.z;
    r4_y = sample21.w;
    r0_x = 255.0 * r0_x + 0.0;
    r1_x = 255.0 * r1_x + 0.0;
    r1_y = 255.0 * r1_y + 0.0;
    r0_y = 255.0 * r0_y + 0.0;
    r1_z = 255.0 * r1_z + 0.0;
    r0_z = 255.0 * r0_z + 0.0;
    r1_w = 255.0 * r1_w + 0.0;
    r0_w = 255.0 * r0_w + 0.0;
    r1_x = 255.0 * r2_z + r1_x;
    r0_x = 255.0 * r3_z + r0_x;
    r1_y = 255.0 * r2_w + r1_y;
    r0_y = 255.0 * r3_w + r0_y;
    r1_z = 255.0 * r3_x + r1_z;
    r0_z = 255.0 * r4_x + r0_z;
    r1_w = 255.0 * r3_y + r1_w;
    r0_w = 255.0 * r4_y + r0_w;
    r0_x = r0_x + r0_y;
    r0_y = r1_x + r1_y;
    r1_x = r1_z + r1_w;
    r0_z = r0_z + r0_w;
    r0_x = 0.25 * r0_x + 0.5;
    r0_y = 0.25 * r0_y + 0.5;
    r0_w = 0.25 * r1_x + 0.5;
    r0_z = 0.25 * r0_z + 0.5;
    r0_x = floor(r0_x);
    r0_y = floor(r0_y);
    r0_w = floor(r0_w);
    r0_z = floor(r0_z);
    hr0_x = r0_x * 0.003921568859368563;
    hr0_y = r0_z * 0.003921568859368563;
    hr0_z = r0_y * 0.003921568859368563;
    hr0_w = r0_w * 0.003921568859368563;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
