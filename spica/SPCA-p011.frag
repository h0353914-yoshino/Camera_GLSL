    hr0_x = hr0_x * hr1_x;
    hr0_y = hr0_y * hr1_y;
    hr0_z = hr0_z * hr1_z;
    hr0_w = hr0_w * hr1_w;
    hr0_x = params.y * hr2_x + hr0_x;
    hr0_y = params.y * hr2_y + hr0_y;
    hr0_z = params.y * hr2_z + hr0_z;
    hr0_w = params.y * hr2_w + hr0_w;
    hr0_x = hr0_x + 0.5;
    hr0_y = hr0_y + 0.5;
    hr0_z = hr0_z + 0.5;
    hr0_w = hr0_w + 0.5;
    hr0_x = hr0_x * 0.00390625;
    hr0_y = hr0_y * 0.00390625;
    hr0_z = hr0_z * 0.00390625;
    hr0_w = hr0_w * 0.00390625;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
