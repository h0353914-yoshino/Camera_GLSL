#version 300 es
precision highp int;
precision highp float;

uniform highp sampler2D texImage;
uniform highp vec4 drOffset;
uniform highp vec2 drGain;
in highp vec2 texCoord;
out highp uvec4 fragColor;

void main()
{
    bool p0;
    bool p1;
    highp vec4 samplePF0;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r63_x;
    drOffset;
    drGain;
    samplePF0 = texture(texImage, texCoord.xy);
    r0_z = samplePF0.x;
    r0_w = samplePF0.y;
    r1_x = samplePF0.z;
    r1_y = samplePF0.w;
    r63_x = texCoord.x;
    r0_x = drGain.y;
    r0_y = drGain.x;
    r0_x = drOffset.y * r0_x + drOffset.w;
    r0_y = (-drOffset.x) * r0_y + drOffset.z;
    r0_z = 255.0 * r0_z + 0.5;
    r0_w = 255.0 * r0_w + 0.5;
    r1_x = 255.0 * r1_x + 0.5;
    r1_y = 255.0 * r1_y + 0.5;
    r0_z = floor(r0_z);
    r0_w = floor(r0_w);
    r1_x = floor(r1_x);
    r1_y = floor(r1_y);
    r1_z = drGain.y * r0_z;
    r1_w = drGain.y * r0_w;
    r2_x = drGain.y * r1_x;
    r2_y = drGain.y * r1_y;
    r0_z = drGain.x * r0_z + r0_y;
    r0_w = drGain.x * r0_w + r0_y;
    r1_x = drGain.x * r1_x + r0_y;
    r0_y = drGain.x * r1_y + r0_y;
    r1_y = r0_x - r1_z;
    r1_z = r0_x - r1_w;
    r1_w = r0_x - r2_x;
    r0_x = r0_x - r2_y;
    r0_z = min(r0_z, r1_y);
    r0_w = min(r0_w, r1_z);
    r1_x = min(r1_x, r1_w);
    r0_x = min(r0_x, r0_y);
    r0_y = max(r0_z, drOffset.z);
    r0_z = max(r0_w, drOffset.z);
    r0_w = max(r1_x, drOffset.z);
    r0_x = max(r0_x, drOffset.z);
    r0_y = min(r0_y, drOffset.w);
    r0_z = min(r0_z, drOffset.w);
    r0_w = min(r0_w, drOffset.w);
    r0_x = min(r0_x, drOffset.w);
    r0_y = max(r0_y, 0.0);
    r0_z = max(r0_z, 0.0);
    r0_w = max(r0_w, 0.0);
    r0_x = max(r0_x, 0.0);
    r0_y = min(r0_y, 4.0);
    r0_z = min(r0_z, 4.0);
    r0_w = min(r0_w, 4.0);
    r0_x = min(r0_x, 4.0);
    r1_x = floor(r0_y);
    r1_y = floor(r0_z);
    r1_z = floor(r0_w);
    r1_w = floor(r0_x);
    r0_y = r0_y - r1_x;
    r0_z = r0_z - r1_y;
    r0_w = r0_w - r1_z;
    r0_x = r0_x - r1_w;
    r0_y = r0_y * 64.0;
    r0_z = r0_z * 64.0;
    r0_w = r0_w * 64.0;
    r0_x = r0_x * 64.0;
    r2_x = floor(r0_y);
    r2_y = floor(r0_z);
    r2_z = floor(r0_w);
    r2_w = floor(r0_x);
    r0_y = r0_y - r2_x;
    r0_z = r0_z - r2_y;
    r0_w = r0_w - r2_z;
    r0_x = r0_x - r2_w;
    r1_x = float(int(r1_x));
    r1_y = float(int(r1_y));
    r1_z = float(int(r1_z));
    r1_w = float(int(r1_w));
    r2_x = float(int(r2_x));
    r2_y = float(int(r2_y));
    r2_z = float(int(r2_z));
    r2_w = float(int(r2_w));
    r0_y = 256.0 * r0_y + 0.5;
    r0_z = 256.0 * r0_z + 0.5;
    r0_w = 256.0 * r0_w + 0.5;
    r0_x = 256.0 * r0_x + 0.5;
    r0_y = floor(r0_y);
    r0_z = floor(r0_z);
    r0_w = floor(r0_w);
    r0_x = floor(r0_x);
    r1_x = r1_x * exp2(14.0);
    r1_y = r1_y * exp2(14.0);
    r1_z = r1_z * exp2(14.0);
    r1_w = r1_w * exp2(14.0);
    r2_x = r2_x * exp2(8.0);
    r2_y = r2_y * exp2(8.0);
    r2_z = r2_z * exp2(8.0);
    r2_w = r2_w * exp2(8.0);
    r0_y = float(int(r0_y));
    r0_z = float(int(r0_z));
    r0_w = float(int(r0_w));
    r0_x = float(int(r0_x));
    r1_x = r1_x + r2_x;
    r1_y = r1_y + r2_y;
    r1_z = r1_z + r2_z;
    r1_w = r1_w + r2_w;
    r0_y = r0_y + r1_x;
    r0_z = r0_z + r1_y;
    r0_w = r0_w + r1_z;
    r0_x = r0_x + r1_w;
    r0_y = min(r0_y, 65535.0);
    r0_z = min(r0_z, 65535.0);
    r0_w = min(r0_w, 65535.0);
    r1_x = min(r0_x, 65535.0);
    fragColor = uvec4(uint(r0_y), uint(r0_z), uint(r0_w), uint(r1_x));
}
