    hr0_x = hr0_x - hr0_z;
    hr0_x = hr0_x * 256.0;
    hr0_x = floor(hr0_x);
    hr0_x = hr0_x * hr0_y;
    hr0_x = bits * hr0_z + hr0_x;
    hr4_z = hr0_x * 0.0039215087890625;
    hr5_x = hr4_w;
    hr4_y = 0.0;
    gl_FragColor = vec4(hr4_y, hr4_z, hr4_w, hr5_x);
}
