    r0_y = params.z * r0_y;
    r0_z = params.z * r0_z;
    r0_w = params.z * r0_w;
    r0_x = max(r0_x, 0.0);
    r0_y = max(r0_y, 0.0);
    r0_z = max(r0_z, 0.0);
    r0_w = max(r0_w, 0.0);
