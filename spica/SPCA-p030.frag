#version 300 es
precision highp int;
precision highp float;

uniform highp vec4 diffPOffset;
uniform highp vec4 drOffset;
uniform highp vec4 levelOffset;
uniform highp vec4 params;
in highp vec2 texCoord;
out highp vec4 fragColor;

void main()
{
    bool p0;
    bool p1;
    highp float r0_w;
