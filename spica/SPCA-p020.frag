    hr0_y = floor(hr0_x);
    hr0_x = hr0_x - hr0_y;
    hr0_x = hr0_x * 256.0;
    hr0_x = floor(hr0_x);
    hr0_x = hr0_x * hr2_x;
    hr0_x = bits * hr0_y + hr0_x;
    hr0_w = hr0_x * 0.0039215087890625;
    hr0_x = 0.0;
    hr0_y = 0.0;
    hr0_z = 0.0;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
