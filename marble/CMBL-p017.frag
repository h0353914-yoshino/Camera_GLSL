#version 100
#extension GL_OES_EGL_image_external : require
precision highp float;

uniform highp samplerExternalOES texUnit1CC;
uniform highp sampler2D texUnit4Cb;
uniform highp sampler2D texUnit8Cb;
uniform highp vec4 texParams;
uniform highp vec2 pixWidth;
uniform highp vec4 moduParamsP0;
uniform highp vec4 moduParamsP1;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample18;
    highp vec4 sample20;
    highp vec4 sample21;
    highp vec4 sample23;
    highp vec4 sample24;
    highp vec4 sample25;
    highp vec4 sample26;
    highp vec4 sample27;
    highp vec4 sample34;
    highp vec4 sample36;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_w;
    highp float r4_x;
    highp float r4_y;
    highp float r4_z;
    highp float r5_w;
    highp float r5_x;
    highp float r5_y;
    highp float r5_z;
    highp float r6_x;
    highp float r6_y;
    texParams;
    pixWidth;
    moduParamsP0;
    moduParamsP1;
    r0_z = texCoord.x;
    r0_w = texCoord.y;
    r0_x = pixWidth.x;
    r0_y = 0.0;
    r1_x = r0_z + texParams.y;
    r1_y = r0_w * texParams.x;
    r1_z = -3.0 * r0_x + r1_x;
    r0_x = 3.0 * r0_x + r1_x;
    r1_w = r1_x - pixWidth.x;
    r1_x = pixWidth.x + r1_x;
    r2_x = r1_y;
    r2_z = r1_y;
    r1_z = r1_z * texParams.z;
    r2_y = r1_w * texParams.z;
    r2_w = r1_x * texParams.z;
    r1_x = r0_x * texParams.z;
    r1_w = r1_z;
    r3_x = r1_y;
    sample18 = texture2D(texUnit4Cb, vec2(r1_x, r1_y));
    r0_x = sample18.x;
    sample20 = texture2D(texUnit4Cb, vec2(r1_w, r2_x));
    r1_z = sample20.x;
    sample21 = texture2D(texUnit4Cb, vec2(r2_y, r2_z));
    r3_y = sample21.x;
    sample23 = texture2D(texUnit4Cb, vec2(r2_w, r3_x));
    r3_z = sample23.x;
    sample24 = texture2D(texUnit8Cb, vec2(r1_w, r2_x));
    r1_w = sample24.x;
    sample25 = texture2D(texUnit8Cb, vec2(r2_y, r2_z));
    r2_x = sample25.x;
    sample26 = texture2D(texUnit8Cb, vec2(r2_w, r3_x));
    r2_y = sample26.x;
    sample27 = texture2D(texUnit8Cb, vec2(r1_x, r1_y));
    r1_x = sample27.x;
    r0_z = r0_z + 0.0;
    r2_w = r0_w;
    r0_y = 0.0;
    r2_z = texParams.w * r0_z + (-pixWidth.y);
    r0_z = texParams.w * r0_z + pixWidth.y;
    sample34 = texture2D(texUnit1CC, vec2(r2_z, r2_w));
    r3_w = sample34.x;
    r4_x = sample34.y;
    r4_y = sample34.z;
    r4_z = sample34.w;
    sample36 = texture2D(texUnit1CC, vec2(r0_z, r0_w));
    r4_w = sample36.x;
    r5_x = sample36.y;
    r5_y = sample36.z;
    r5_z = sample36.w;
    r0_x = 255.0 * r0_x + 0.5;
    r0_z = 255.0 * r1_z + 0.5;
    r0_w = 255.0 * r3_y + 0.5;
    r0_x = floor(r0_x);
    r1_y = 255.0 * r3_z + 0.5;
    r1_z = 255.0 * r1_w + 0.5;
    r1_w = 255.0 * r2_x + 0.5;
    r2_x = 255.0 * r2_y + 0.5;
    r1_x = 255.0 * r1_x + 0.5;
    r0_z = floor(r0_z);
    r0_w = floor(r0_w);
    r1_y = floor(r1_y);
    r1_z = floor(r1_z);
    r1_w = floor(r1_w);
    r2_x = floor(r2_x);
    r1_x = floor(r1_x);
    r2_y = r0_z - r1_z;
    r2_z = r0_w - r1_w;
    r2_w = r1_y - r2_x;
    r3_x = r0_x - r1_x;
    r2_y = max(abs(r2_y), moduParamsP0.x);
    r2_z = max(abs(r2_z), moduParamsP0.x);
    r2_w = max(abs(r2_w), moduParamsP0.x);
    r3_x = max(abs(r3_x), moduParamsP0.x);
    r2_y = min(r2_y, moduParamsP1.x);
    r2_z = min(r2_z, moduParamsP1.x);
    r2_w = min(r2_w, moduParamsP1.x);
    r3_x = min(r3_x, moduParamsP1.x);
    r3_y = 0.0 * r4_z;
    r3_z = 0.0 * r5_z;
    r3_y = 0.0 * r4_y + r3_y;
    r2_y = r2_y - moduParamsP0.x;
    r2_z = r2_z - moduParamsP0.x;
    r2_w = r2_w - moduParamsP0.x;
    r3_x = r3_x - moduParamsP0.x;
    r2_y = moduParamsP0.y * r2_y + moduParamsP1.y;
    r2_z = moduParamsP0.y * r2_z + moduParamsP1.y;
    r2_w = moduParamsP0.y * r2_w + moduParamsP1.y;
    r3_x = moduParamsP0.y * r3_x + moduParamsP1.y;
    r2_y = min(r2_y, 1.0);
    r2_z = min(r2_z, 1.0);
    r2_w = min(r2_w, 1.0);
    r3_x = min(r3_x, 1.0);
    r4_y = 1.0 - r2_y;
    r5_w = 1.0 - r2_z;
    r6_x = 1.0 - r2_w;
    r6_y = 1.0 - r3_x;
    r3_z = 0.0 * r5_y + r3_z;
    r0_z = r0_z * r2_y;
    r0_w = r0_w * r2_z;
    r1_y = r1_y * r2_w;
    r0_x = r0_x * r3_x;
    r2_y = 0.0 * r4_x + r3_y;
    r2_z = 0.0 * r5_x + r3_z;
    r0_z = r1_z * r4_y + r0_z;
    r0_w = r1_w * r5_w + r0_w;
    r1_y = r2_x * r6_x + r1_y;
    r0_x = r1_x * r6_y + r0_x;
    r1_x = 0.0 * r3_w + r2_y;
    r1_z = 0.0 * r4_w + r2_z;
    r1_w = (r0_y != 0.0) ? 1.0 : r4_z;
    r0_z = r0_z + 0.5;
    r0_w = r0_w + 0.5;
    r1_y = r1_y + 0.5;
    r0_x = r0_x + 0.5;
    r1_x = (r0_y != 0.0) ? r1_x : r4_x;
    r1_z = (r0_y != 0.0) ? r1_z : r5_x;
    r0_y = (r0_y != 0.0) ? 1.0 : r5_z;
    r0_z = floor(r0_z);
    r0_w = floor(r0_w);
    r1_y = floor(r1_y);
    r0_x = floor(r0_x);
    r2_x = 255.0 * r1_x + (-r0_z);
    r2_y = 255.0 * r1_w + (-r0_w);
    r2_z = 255.0 * r1_z + (-r1_y);
    r2_w = 255.0 * r0_y + (-r0_x);
    r2_x = max(abs(r2_x), moduParamsP0.z);
    r2_y = max(abs(r2_y), moduParamsP0.z);
    r2_z = max(abs(r2_z), moduParamsP0.z);
    r2_w = max(abs(r2_w), moduParamsP0.z);
    r2_x = min(r2_x, moduParamsP1.z);
    r2_y = min(r2_y, moduParamsP1.z);
    r2_z = min(r2_z, moduParamsP1.z);
    r2_w = min(r2_w, moduParamsP1.z);
    r1_x = r1_x * 255.0;
    r1_w = r1_w * 255.0;
    r1_z = r1_z * 255.0;
    r0_y = r0_y * 255.0;
    r2_x = r2_x - moduParamsP0.z;
    r2_y = r2_y - moduParamsP0.z;
    r2_z = r2_z - moduParamsP0.z;
    r2_w = r2_w - moduParamsP0.z;
    r2_x = moduParamsP0.w * r2_x + moduParamsP1.w;
    r2_y = moduParamsP0.w * r2_y + moduParamsP1.w;
    r2_z = moduParamsP0.w * r2_z + moduParamsP1.w;
    r2_w = moduParamsP0.w * r2_w + moduParamsP1.w;
    r2_x = min(r2_x, 1.0);
    r2_y = min(r2_y, 1.0);
    r2_z = min(r2_z, 1.0);
    r2_w = min(r2_w, 1.0);
    r3_x = 1.0 - r2_x;
    r3_y = 1.0 - r2_y;
    r3_z = 1.0 - r2_z;
    r3_w = 1.0 - r2_w;
    r1_x = r1_x * r2_x;
    r1_w = r1_w * r2_y;
    r1_z = r1_z * r2_z;
    r0_y = r0_y * r2_w;
    r0_z = r0_z * r3_x + r1_x;
    r0_w = r0_w * r3_y + r1_w;
    r1_x = r1_y * r3_z + r1_z;
    r0_x = r0_x * r3_w + r0_y;
    r0_y = r0_z + 0.5;
    r0_z = r0_w + 0.5;
    r0_w = r1_x + 0.5;
    r0_x = r0_x + 0.5;
    r0_y = floor(r0_y);
    r0_z = floor(r0_z);
    r0_w = floor(r0_w);
    r0_x = floor(r0_x);
    hr0_x = r0_y * 0.003921568859368563;
    hr0_y = r0_z * 0.003921568859368563;
    hr0_z = r0_w * 0.003921568859368563;
    hr0_w = r0_x * 0.003921568859368563;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
