#version 100
precision highp float;

uniform highp sampler2D texYY1;
uniform highp sampler2D texYY2;
uniform highp sampler2D texMap1;
uniform highp vec4 params;
uniform highp vec4 mapOffset;
uniform highp vec4 moduParams;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample16;
    highp vec4 sample17;
    highp vec4 sample19;
    highp vec4 sample21;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    params;
    mapOffset;
    moduParams;
    r0_z = texCoord.x;
    r0_w = texCoord.y;
    r0_x = params.x;
    r0_y = params.y + r0_z;
    r1_y = r0_w * mapOffset.z;
    r1_x = (-1.5) * r0_x + r0_y;
    r0_x = 1.5 * r0_x + r0_y;
    r0_z = r0_z + 3.0;
    r1_w = r1_y;
    r1_z = r1_x * params.z;
    r1_x = r0_x * params.z;
    r0_x = r0_z * params.w;
    r0_y = params.z * r0_y + mapOffset.x;
    r0_z = mapOffset.z * r0_w + mapOffset.y;
    r2_x = r0_x;
    r2_y = r0_w;
    sample16 = texture2D(texYY2, vec2(r1_x, r1_y));
    r0_w = sample16.w;
    sample17 = texture2D(texYY2, vec2(r1_z, r1_w));
    r1_x = sample17.w;
    sample19 = texture2D(texMap1, vec2(r0_y, r0_z));
    r1_y = sample19.w;
    sample21 = texture2D(texYY1, vec2(r2_x, r2_y));
    r1_z = sample21.x;
    r1_w = sample21.y;
    r2_x = sample21.z;
    r2_y = sample21.w;
    r0_x = r0_w * 255.0;
    r0_y = r1_x * 255.0;
    r0_z = r1_y * 255.0;
    r0_w = r0_x * 0.3333333432674408;
    r1_x = r0_y * 0.3333333432674408;
    r0_w = 0.6666666269302368 * r0_y + r0_w;
    r1_x = 0.6666666269302368 * r0_x + r1_x;
    r1_y = r0_z * moduParams.x;
    r2_z = 255.0 * r1_z + (-r0_y);
    r2_w = 255.0 * r1_w + (-r0_w);
    r3_x = 255.0 * r2_x + (-r1_x);
    r3_y = 255.0 * r2_y + (-r0_x);
    r3_z = r0_z * moduParams.y;
    r2_z = max(r1_y, abs(r2_z));
    r2_w = max(r1_y, abs(r2_w));
    r3_x = max(r1_y, abs(r3_x));
    r1_y = max(r1_y, abs(r3_y));
    r2_z = min(r2_z, r3_z);
    r2_w = min(r2_w, r3_z);
    r3_x = min(r3_x, r3_z);
    r1_y = min(r1_y, r3_z);
    r2_z = (-moduParams.x) * r0_z + r2_z;
    r2_w = (-moduParams.x) * r0_z + r2_w;
    r3_x = (-moduParams.x) * r0_z + r3_x;
    r1_y = (-moduParams.x) * r0_z + r1_y;
    r1_z = r1_z * 255.0;
    r1_w = r1_w * 255.0;
    r2_x = r2_x * 255.0;
    r2_y = r2_y * 255.0;
    r2_z = moduParams.w * r2_z;
    r2_w = moduParams.w * r2_w;
    r3_x = moduParams.w * r3_x;
    r1_y = moduParams.w * r1_y;
    r2_z = moduParams.z * r0_z + (-r2_z);
    r2_w = moduParams.z * r0_z + (-r2_w);
    r3_x = moduParams.z * r0_z + (-r3_x);
    r0_z = moduParams.z * r0_z + (-r1_y);
    r1_y = 1.0 - r2_z;
    r3_y = 1.0 - r2_w;
    r3_z = 1.0 - r3_x;
    r3_w = 1.0 - r0_z;
    r0_y = r0_y * r2_z;
    r0_w = r0_w * r2_w;
    r1_x = r1_x * r3_x;
    r0_x = r0_x * r0_z;
    r0_y = r1_y * r1_z + r0_y;
    r0_z = r1_w * r3_y + r0_w;
    r0_w = r2_x * r3_z + r1_x;
    r0_x = r2_y * r3_w + r0_x;
    r0_y = r0_y + 0.5;
    r0_z = r0_z + 0.5;
    r0_w = r0_w + 0.5;
    r0_x = r0_x + 0.5;
    r0_y = floor(r0_y);
    r0_z = floor(r0_z);
    r0_w = floor(r0_w);
    r0_x = floor(r0_x);
    hr0_x = r0_y * 0.003921568859368563;
    hr0_y = r0_z * 0.003921568859368563;
    hr0_z = r0_w * 0.003921568859368563;
    hr0_w = r0_x * 0.003921568859368563;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
