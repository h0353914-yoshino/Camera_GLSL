#version 100
precision highp float;

uniform highp sampler2D texC1;
uniform highp sampler2D texC2;
uniform highp vec4 moduParams;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 samplePF0;
    highp vec4 samplePF1;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r63_x;
    moduParams;
    samplePF0 = texture2D(texC1, texCoord.xy);
    r0_z = samplePF0.x;
    r0_w = samplePF0.y;
    r1_x = samplePF0.z;
    r1_y = samplePF0.w;
    samplePF1 = texture2D(texC2, texCoord.xy);
    r1_z = samplePF1.x;
    r1_w = samplePF1.y;
    r2_x = samplePF1.z;
    r2_y = samplePF1.w;
    r63_x = texCoord.x;
    r0_x = r1_z * 255.0;
    r0_y = r1_w * 255.0;
    r1_z = r2_x * 255.0;
    r1_w = r2_y * 255.0;
    r2_x = 255.0 * r0_z + (-r0_x);
    r2_y = 255.0 * r0_w + (-r0_y);
    r2_z = 255.0 * r1_x + (-r1_z);
    r2_w = 255.0 * r1_y + (-r1_w);
    r2_x = max(abs(r2_x), moduParams.x);
    r2_y = max(abs(r2_y), moduParams.x);
    r2_z = max(abs(r2_z), moduParams.x);
    r2_w = max(abs(r2_w), moduParams.x);
    r2_x = min(r2_x, moduParams.y);
    r2_y = min(r2_y, moduParams.y);
    r2_z = min(r2_z, moduParams.y);
    r2_w = min(r2_w, moduParams.y);
