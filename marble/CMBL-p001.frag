    r0_w = r0_w * 255.0;
    r1_x = r1_x * 255.0;
    r1_y = r1_y * 255.0;
    r2_x = r2_x - moduParams.x;
    r2_y = r2_y - moduParams.x;
    r2_z = r2_z - moduParams.x;
    r2_w = r2_w - moduParams.x;
    r2_x = moduParams.w * r2_x + moduParams.z;
    r2_y = moduParams.w * r2_y + moduParams.z;
    r2_z = moduParams.w * r2_z + moduParams.z;
    r2_w = moduParams.w * r2_w + moduParams.z;
    r2_x = min(r2_x, 1.0);
    r2_y = min(r2_y, 1.0);
    r2_z = min(r2_z, 1.0);
    r2_w = min(r2_w, 1.0);
    r3_x = 1.0 - r2_x;
    r3_y = 1.0 - r2_y;
    r3_z = 1.0 - r2_z;
    r3_w = 1.0 - r2_w;
    r0_z = r0_z * r2_x;
    r0_w = r0_w * r2_y;
    r1_x = r1_x * r2_z;
    r1_y = r1_y * r2_w;
    r0_x = r0_x * r3_x + r0_z;
    r0_y = r0_y * r3_y + r0_w;
    r0_z = r1_z * r3_z + r1_x;
    r0_w = r1_w * r3_w + r1_y;
    r0_x = r0_x + 0.5;
    r0_y = r0_y + 0.5;
    r0_z = r0_z + 0.5;
    r0_w = r0_w + 0.5;
