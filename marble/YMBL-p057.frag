#version 100
precision highp float;

uniform highp sampler2D texUnitKK;
uniform highp sampler2D texUnitYK;
uniform highp sampler2D texUnitFDW;
uniform highp float lapRatio;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample15;
    highp vec4 sample16;
    highp vec4 sample18;
    highp vec4 sample20;
    highp vec4 samplePF0;
    highp vec4 samplePF1;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_x;
    lapRatio;
    samplePF0 = texture2D(texUnitYK, texCoord.xy);
    r0_z = samplePF0.x;
    r0_w = samplePF0.y;
    r1_x = samplePF0.z;
    r1_y = samplePF0.w;
    samplePF1 = texture2D(texUnitKK, texCoord.xy);
    r1_z = samplePF1.x;
    r1_w = samplePF1.y;
    r2_x = samplePF1.z;
    r2_y = samplePF1.w;
    r2_z = texCoord.x;
    r2_w = texCoord.y;
    r0_x = lapRatio;
    r0_y = r2_w;
    r3_x = r2_w;
    r0_x = 2.0 * r0_x + 0.25;
    r3_z = r2_w;
    r4_x = r2_w;
    r0_x = r0_x * r2_z + (-lapRatio);
    r2_w = r0_x + 0.25;
    r3_y = r2_w + 0.25;
    r3_w = r3_y + 0.25;
    sample15 = texture2D(texUnitFDW, vec2(r0_x, r0_y));
    r0_y = sample15.y;
    sample16 = texture2D(texUnitFDW, vec2(r2_w, r3_x));
    r2_z = sample16.y;
    sample18 = texture2D(texUnitFDW, vec2(r3_y, r3_z));
    r2_w = sample18.y;
    sample20 = texture2D(texUnitFDW, vec2(r3_w, r4_x));
    r3_x = sample20.y;
    r0_x = 1.0 - r0_y;
    r0_y = r0_y * r1_z;
    r1_z = 1.0 - r2_z;
    r1_w = r1_w * r2_z;
    r0_x = r0_x * r0_z + r0_y;
    r0_y = 1.0 - r2_w;
    r0_z = r2_x * r2_w;
    r0_w = r0_w * r1_z + r1_w;
    r1_z = 1.0 - r3_x;
    r1_w = r2_y * r3_x;
    r0_y = r0_y * r1_x + r0_z;
    r0_x = 255.0 * r0_x + 0.5;
    r0_z = r1_y * r1_z + r1_w;
    r0_w = 255.0 * r0_w + 0.5;
    r0_y = 255.0 * r0_y + 0.5;
    r0_x = floor(r0_x);
    r0_z = 255.0 * r0_z + 0.5;
    r0_w = floor(r0_w);
    r0_y = floor(r0_y);
    r0_z = floor(r0_z);
    hr0_x = r0_x * 0.003921568859368563;
    hr0_y = r0_w * 0.003921568859368563;
    hr0_z = r0_y * 0.003921568859368563;
    hr0_w = r0_z * 0.003921568859368563;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
