#version 100
precision highp float;

uniform highp sampler2D texYY1;
uniform highp sampler2D texYY2;
uniform highp sampler2D texMap1;
uniform highp vec2 mapOffset;
uniform highp vec4 moduParams;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample6;
    highp vec4 samplePF0;
    highp vec4 samplePF1;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_w;
    highp float r4_x;
    highp float r4_y;
    highp float r4_z;
    highp float r5_w;
    highp float r5_x;
    highp float r5_y;
    highp float r5_z;
    mapOffset;
    moduParams;
    samplePF0 = texture2D(texYY2, texCoord.xy);
    r0_z = samplePF0.x;
    r0_w = samplePF0.y;
    r1_x = samplePF0.z;
    r1_y = samplePF0.w;
    samplePF1 = texture2D(texYY1, texCoord.xy);
    r1_z = samplePF1.x;
    r1_w = samplePF1.y;
    r2_x = samplePF1.z;
    r2_y = samplePF1.w;
    r2_z = texCoord.x;
    r2_w = texCoord.y;
    r0_x = r2_z + mapOffset.x;
    r0_y = r2_w + mapOffset.y;
    sample6 = texture2D(texMap1, vec2(r0_x, r0_y));
    r2_z = sample6.x;
    r2_w = sample6.y;
    r3_x = sample6.z;
    r3_y = sample6.w;
    r0_x = r1_z - r0_z;
    r0_y = r1_w - r0_w;
    r3_z = r2_x - r1_x;
    r3_w = r2_y - r1_y;
    r4_x = r2_z * moduParams.x;
    r4_y = r2_w * moduParams.x;
    r4_z = r3_x * moduParams.x;
    r4_w = r3_y * moduParams.x;
    r5_x = r2_z * moduParams.y;
    r5_y = r2_w * moduParams.y;
    r5_z = r3_x * moduParams.y;
    r5_w = r3_y * moduParams.y;
    r0_x = max(abs(r0_x), r4_x);
    r0_y = max(abs(r0_y), r4_y);
    r3_z = max(abs(r3_z), r4_z);
    r3_w = max(abs(r3_w), r4_w);
    r0_x = min(r0_x, r5_x);
    r0_y = min(r0_y, r5_y);
    r3_z = min(r3_z, r5_z);
    r3_w = min(r3_w, r5_w);
    r0_x = (-moduParams.x) * r2_z + r0_x;
    r0_y = (-moduParams.x) * r2_w + r0_y;
    r3_z = (-moduParams.x) * r3_x + r3_z;
    r3_w = (-moduParams.x) * r3_y + r3_w;
    r2_z = (-moduParams.z) * r2_z + 1.0;
    r2_w = (-moduParams.z) * r2_w + 1.0;
    r3_x = (-moduParams.z) * r3_x + 1.0;
    r3_y = (-moduParams.z) * r3_y + 1.0;
    r0_x = moduParams.w * r0_x + r2_z;
    r0_y = moduParams.w * r0_y + r2_w;
    r2_z = moduParams.w * r3_z + r3_x;
    r2_w = moduParams.w * r3_w + r3_y;
    r3_x = 1.0 - r0_x;
    r3_y = 1.0 - r0_y;
    r3_z = 1.0 - r2_z;
    r3_w = 1.0 - r2_w;
    r0_x = r0_x * r1_z;
    r0_y = r0_y * r1_w;
    r1_z = r2_x * r2_z;
    r1_w = r2_y * r2_w;
    r0_x = r0_z * r3_x + r0_x;
    r0_y = r0_w * r3_y + r0_y;
    r0_z = r1_x * r3_z + r1_z;
    r0_w = r1_y * r3_w + r1_w;
    r0_x = 255.0 * r0_x + 0.5;
    r0_y = 255.0 * r0_y + 0.5;
    r0_z = 255.0 * r0_z + 0.5;
    r0_w = 255.0 * r0_w + 0.5;
    r0_x = floor(r0_x);
    r0_y = floor(r0_y);
    r0_z = floor(r0_z);
    r0_w = floor(r0_w);
    hr0_x = r0_x * 0.003921568859368563;
    hr0_y = r0_y * 0.003921568859368563;
    hr0_z = r0_z * 0.003921568859368563;
    hr0_w = r0_w * 0.003921568859368563;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
