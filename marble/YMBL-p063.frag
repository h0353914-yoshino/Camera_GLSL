#version 100
precision highp float;

uniform highp sampler2D texUnit0;
uniform highp vec4 pixSize;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample10;
    highp vec4 sample12;
    highp vec4 sample14;
    highp vec4 sample8;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_w;
    highp float r4_x;
    highp float r4_y;
    highp float r4_z;
    pixSize;
    r0_z = texCoord.x;
    r0_w = texCoord.y;
    r0_x = r0_z - pixSize.z;
    r0_y = r0_w - pixSize.w;
    r0_z = r0_z + pixSize.z;
    r0_w = r0_w + pixSize.w;
    r1_x = r0_x;
    r1_y = r0_y;
    r1_z = r0_z;
    r1_w = r0_y;
    r0_y = r0_w;
    sample8 = texture2D(texUnit0, vec2(r0_z, r0_w));
    r2_x = sample8.x;
    r2_y = sample8.y;
    r2_z = sample8.z;
    r2_w = sample8.w;
    sample10 = texture2D(texUnit0, vec2(r1_x, r1_y));
    r0_z = sample10.x;
    r0_w = sample10.y;
    r1_x = sample10.z;
    r1_y = sample10.w;
    sample12 = texture2D(texUnit0, vec2(r1_z, r1_w));
    r3_x = sample12.x;
    r3_y = sample12.y;
    r3_z = sample12.z;
    r3_w = sample12.w;
    sample14 = texture2D(texUnit0, vec2(r0_x, r0_y));
    r4_x = sample14.x;
    r4_y = sample14.y;
    r4_z = sample14.z;
    r4_w = sample14.w;
    r0_x = r0_z + r3_x;
    r0_y = r0_w + r3_y;
    r0_z = r1_x + r3_z;
    r0_w = r1_y + r3_w;
    r0_x = r0_x + r4_x;
    r0_y = r0_y + r4_y;
    r0_z = r0_z + r4_z;
    r0_w = r0_w + r4_w;
    r0_x = r0_x + r2_x;
    r0_y = r0_y + r2_y;
    r0_z = r0_z + r2_z;
    r0_w = r0_w + r2_w;
    r0_x = 0.25 * r0_x + 3.9999999e-05;
    r0_y = 0.25 * r0_y + 3.9999999e-05;
    r0_z = 0.25 * r0_z + 3.9999999e-05;
    r0_w = 0.25 * r0_w + 3.9999999e-05;
    r0_x = 255.0 * r0_x + 0.5;
    r0_y = 255.0 * r0_y + 0.5;
    r0_z = 255.0 * r0_z + 0.5;
    r0_w = 255.0 * r0_w + 0.5;
    r0_x = floor(r0_x);
    r0_y = floor(r0_y);
    r0_z = floor(r0_z);
    r0_w = floor(r0_w);
    hr0_x = r0_x * 0.003921568859368563;
    hr0_y = r0_y * 0.003921568859368563;
    hr0_z = r0_z * 0.003921568859368563;
    hr0_w = r0_w * 0.003921568859368563;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
