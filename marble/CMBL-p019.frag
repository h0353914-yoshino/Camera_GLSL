#version 100
#extension GL_OES_EGL_image_external : require
precision highp float;

uniform highp samplerExternalOES texUnit1CC;
uniform highp sampler2D texUnit4Cb;
uniform highp sampler2D texUnit4Cr;
uniform highp sampler2D texUnit8Cb;
uniform highp sampler2D texUnit8Cr;
uniform highp vec4 texParams;
uniform highp vec2 pixWidth;
uniform highp vec4 moduParamsP0;
uniform highp vec4 moduParamsP1;
uniform highp vec4 moduParamsGain;
uniform highp vec4 moduParamsFlat;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample15;
    highp vec4 sample16;
    highp vec4 sample17;
    highp vec4 sample18;
    highp vec4 sample19;
    highp vec4 sample20;
    highp vec4 sample21;
    highp vec4 sample22;
    highp vec4 sample23;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_w;
    highp float r4_x;
    highp float r4_y;
    highp float r4_z;
    highp float r5_w;
    highp float r5_x;
    highp float r5_y;
    highp float r5_z;
    texParams;
    pixWidth;
    moduParamsP0;
    moduParamsP1;
    moduParamsGain;
    moduParamsFlat;
    r0_z = texCoord.x;
    r0_w = texCoord.y;
    r0_x = 0.0;
    r0_y = r0_z + texParams.y;
    r1_x = r0_w * texParams.x;
    r0_z = r0_z + 3.0;
    r1_z = r0_w;
    r0_w = r0_y - pixWidth.x;
    r0_y = r0_y + pixWidth.x;
    r2_x = r1_x;
    r1_y = r0_z * texParams.w;
    r1_w = r0_w * texParams.z;
    r0_w = r0_y * texParams.z;
    r0_x = 0.0;
    sample15 = texture2D(texUnit4Cb, vec2(r0_w, r1_x));
    r2_y = sample15.w;
    sample16 = texture2D(texUnit4Cb, vec2(r1_w, r2_x));
    r2_z = sample16.w;
    sample17 = texture2D(texUnit4Cr, vec2(r1_w, r2_x));
    r2_w = sample17.w;
    sample18 = texture2D(texUnit4Cr, vec2(r0_w, r1_x));
    r3_x = sample18.w;
    sample19 = texture2D(texUnit8Cb, vec2(r1_w, r2_x));
    r3_y = sample19.w;
    sample20 = texture2D(texUnit8Cb, vec2(r0_w, r1_x));
    r3_z = sample20.w;
    sample21 = texture2D(texUnit8Cr, vec2(r1_w, r2_x));
    r1_w = sample21.w;
    sample22 = texture2D(texUnit8Cr, vec2(r0_w, r1_x));
    r0_w = sample22.w;
    sample23 = texture2D(texUnit1CC, vec2(r1_y, r1_z));
    r3_w = sample23.x;
    r4_x = sample23.y;
    r4_y = sample23.z;
    r4_z = sample23.w;
    r0_y = 255.0 * r2_y + 0.5;
    r0_z = 255.0 * r2_z + 0.5;
    r1_x = 255.0 * r2_w + 0.5;
    r1_y = 255.0 * r3_x + 0.5;
    r1_z = 255.0 * r3_y + 0.5;
    r2_x = 255.0 * r3_z + 0.5;
    r1_w = 255.0 * r1_w + 0.5;
    r0_w = 255.0 * r0_w + 0.5;
    r0_z = floor(r0_z);
    r1_x = floor(r1_x);
    r0_y = floor(r0_y);
    r1_y = floor(r1_y);
    r1_z = floor(r1_z);
    r1_w = floor(r1_w);
    r2_x = floor(r2_x);
    r0_w = floor(r0_w);
    r2_y = 0.0 * r4_z;
    r2_z = 0.0 * r4_z;
    r2_w = 0.0 * r4_z;
    r3_x = r0_z - r1_z;
    r3_y = r1_x - r1_w;
    r3_z = r0_y - r2_x;
    r4_w = r1_y - r0_w;
    r3_x = max(abs(r3_x), moduParamsP0.x);
    r3_y = max(abs(r3_y), moduParamsP0.y);
    r3_z = max(abs(r3_z), moduParamsP0.x);
    r4_w = max(abs(r4_w), moduParamsP0.y);
    r3_x = min(r3_x, moduParamsP1.x);
    r3_y = min(r3_y, moduParamsP1.y);
    r3_z = min(r3_z, moduParamsP1.x);
    r4_w = min(r4_w, moduParamsP1.y);
    r2_y = 0.0 * r4_y + r2_y;
    r2_z = 0.0 * r4_y + r2_z;
    r2_w = 0.0 * r4_y + r2_w;
    r3_x = r3_x - moduParamsP0.x;
    r3_y = r3_y - moduParamsP0.y;
    r3_z = r3_z - moduParamsP0.x;
    r4_w = r4_w - moduParamsP0.y;
    r3_x = moduParamsGain.x * r3_x + moduParamsFlat.x;
    r3_y = moduParamsGain.y * r3_y + moduParamsFlat.y;
    r3_z = moduParamsGain.x * r3_z + moduParamsFlat.x;
    r4_w = moduParamsGain.y * r4_w + moduParamsFlat.y;
    r3_x = min(r3_x, 1.0);
    r3_y = min(r3_y, 1.0);
    r3_z = min(r3_z, 1.0);
    r4_w = min(r4_w, 1.0);
    r5_x = 1.0 - r3_x;
    r5_y = 1.0 - r3_y;
    r5_z = 1.0 - r3_z;
    r5_w = 1.0 - r4_w;
    r2_y = 0.0 * r4_x + r2_y;
    r2_z = 0.0 * r4_x + r2_z;
    r2_w = 0.0 * r4_x + r2_w;
    r0_z = r0_z * r3_x;
    r1_x = r1_x * r3_y;
    r0_y = r0_y * r3_z;
    r1_y = r1_y * r4_w;
    r0_z = r1_z * r5_x + r0_z;
    r1_x = r1_w * r5_y + r1_x;
    r0_y = r2_x * r5_z + r0_y;
    r0_w = r0_w * r5_w + r1_y;
    r1_y = 0.0 * r3_w + r2_y;
    r1_z = 0.0 * r3_w + r2_z;
    r1_w = 0.0 * r3_w + r2_w;
    r0_z = r0_z + 0.5;
    r1_x = r1_x + 0.5;
    r0_y = r0_y + 0.5;
    r0_w = r0_w + 0.5;
    r1_y = (r0_x != 0.0) ? r1_y : r3_w;
    r1_z = (r0_x != 0.0) ? r1_z : r4_x;
    r1_w = (r0_x != 0.0) ? r1_w : r4_y;
    r0_x = (r0_x != 0.0) ? 1.0 : r4_z;
    r0_z = floor(r0_z);
    r1_x = floor(r1_x);
    r0_y = floor(r0_y);
    r0_w = floor(r0_w);
    r2_x = 255.0 * r1_y + (-r0_z);
    r2_y = 255.0 * r1_z + (-r1_x);
    r2_z = 255.0 * r1_w + (-r0_y);
    r2_w = 255.0 * r0_x + (-r0_w);
    r2_x = max(abs(r2_x), moduParamsP0.z);
    r2_y = max(abs(r2_y), moduParamsP0.w);
    r2_z = max(abs(r2_z), moduParamsP0.z);
    r2_w = max(abs(r2_w), moduParamsP0.w);
    r2_x = min(r2_x, moduParamsP1.z);
    r2_y = min(r2_y, moduParamsP1.w);
    r2_z = min(r2_z, moduParamsP1.z);
    r2_w = min(r2_w, moduParamsP1.w);
    r1_y = r1_y * 255.0;
    r1_z = r1_z * 255.0;
    r1_w = r1_w * 255.0;
    r0_x = r0_x * 255.0;
    r2_x = r2_x - moduParamsP0.z;
    r2_y = r2_y - moduParamsP0.w;
    r2_z = r2_z - moduParamsP0.z;
    r2_w = r2_w - moduParamsP0.w;
    r2_x = moduParamsGain.z * r2_x + moduParamsFlat.z;
    r2_y = moduParamsGain.w * r2_y + moduParamsFlat.w;
    r2_z = moduParamsGain.z * r2_z + moduParamsFlat.z;
    r2_w = moduParamsGain.w * r2_w + moduParamsFlat.w;
    r2_x = min(r2_x, 1.0);
    r2_y = min(r2_y, 1.0);
    r2_z = min(r2_z, 1.0);
    r2_w = min(r2_w, 1.0);
    r3_x = 1.0 - r2_x;
    r3_y = 1.0 - r2_y;
    r3_z = 1.0 - r2_z;
    r3_w = 1.0 - r2_w;
    r1_y = r1_y * r2_x;
    r1_z = r1_z * r2_y;
    r1_w = r1_w * r2_z;
    r0_x = r0_x * r2_w;
    r0_z = r0_z * r3_x + r1_y;
    r1_x = r1_x * r3_y + r1_z;
    r0_y = r0_y * r3_z + r1_w;
    r0_x = r0_w * r3_w + r0_x;
    r0_z = r0_z + 0.5;
    r0_w = r1_x + 0.5;
    r0_y = r0_y + 0.5;
    r0_x = r0_x + 0.5;
    r0_z = floor(r0_z);
    r0_w = floor(r0_w);
    r0_y = floor(r0_y);
    r0_x = floor(r0_x);
    hr0_x = r0_z * 0.003921568859368563;
    hr0_y = r0_w * 0.003921568859368563;
    hr0_z = r0_y * 0.003921568859368563;
    hr0_w = r0_x * 0.003921568859368563;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
