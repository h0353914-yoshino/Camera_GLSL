#version 300 es
precision highp int;
precision highp float;

uniform highp sampler2D texUnit0;
uniform highp vec4 pixSize;
in highp vec2 texCoord;
out highp vec4 fragColor;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample10;
    highp vec4 sample12;
    highp vec4 sample6;
    highp vec4 sample8;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    pixSize;
    r0_z = texCoord.x;
    r0_w = texCoord.y;
    r0_x = r0_z - pixSize.z;
    r0_y = r0_w - pixSize.w;
    r1_x = r0_z - pixSize.x;
    r1_y = r0_w - pixSize.y;
    r1_z = r0_z + pixSize.x;
    r1_w = r0_w + pixSize.y;
    r0_z = r0_z + pixSize.z;
    r0_w = r0_w + pixSize.w;
    sample6 = texture(texUnit0, vec2(r0_x, r0_y));
    r2_x = sample6.x;
    r2_y = sample6.y;
    r2_z = sample6.z;
    r2_w = sample6.w;
    sample8 = texture(texUnit0, vec2(r1_x, r1_y));
    r3_x = sample8.x;
    r3_y = sample8.y;
    r3_z = sample8.z;
    r3_w = sample8.w;
    sample10 = texture(texUnit0, vec2(r1_z, r1_w));
    r1_x = sample10.x;
    r1_y = sample10.y;
    r1_z = sample10.z;
    r1_w = sample10.w;
    sample12 = texture(texUnit0, vec2(r0_z, r0_w));
    r0_x = sample12.x;
    r0_y = sample12.y;
    r0_z = sample12.z;
    r0_w = sample12.w;
    r2_x = r2_x + r3_x;
    r2_y = r2_y + r3_y;
    r2_z = r2_z + r3_z;
    r2_w = r2_w + r3_w;
    r1_x = r1_x + r2_x;
    r1_y = r1_y + r2_y;
    r1_z = r1_z + r2_z;
    r1_w = r1_w + r2_w;
    r0_x = r0_x + r1_x;
    r0_y = r0_y + r1_y;
    r0_z = r0_z + r1_z;
    r0_w = r0_w + r1_w;
    r0_x = r0_x + r0_y;
    r0_x = r0_x + r0_z;
    r0_x = r0_x + r0_w;
    r0_x = r0_x * 0.0625;
    r0_y = 0.0;
    r0_z = 0.0;
    r0_w = 0.0;
    fragColor = vec4(r0_x, r0_y, r0_z, r0_w);
}
