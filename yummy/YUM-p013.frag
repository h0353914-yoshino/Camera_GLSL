    r5_y = param.x * r5_y;
    r5_z = param.x * r5_z;
    r6_x = param.x * r6_x;
    r5_x = param.y * r8_y + r5_x;
    r5_y = param.y * r8_z + r5_y;
    r5_z = param.y * r8_w + r5_z;
    r6_x = param.y * r9_x + r6_x;
    r6_y = min(r6_y, r7_y);
    r6_z = min(r6_z, r7_z);
    r6_w = min(r6_w, r7_w);
    r7_x = min(r7_x, r8_x);
    r0_x = r0_x * r5_x;
    r4_x = r4_x * r5_y;
    r4_y = r4_y * r5_z;
    r4_z = r4_z * r6_x;
