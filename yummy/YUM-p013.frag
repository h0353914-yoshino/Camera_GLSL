    r5_y = r6_z * 0.00390625;
    r5_z = r6_w * 0.00390625;
    r6_x = r7_x * 0.00390625;
    r0_x = r0_x * r5_x;
    r4_x = r4_x * r5_y;
    r4_y = r4_y * r5_z;
    r4_z = r4_z * r6_x;
