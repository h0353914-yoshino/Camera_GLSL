#version 300 es
precision highp int;
precision highp float;

uniform highp sampler2D texUnit0;
uniform highp vec4 pixSize;
in highp vec2 texCoord;
out highp vec4 fragColor;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample18;
    highp vec4 sample19;
    highp vec4 sample20;
    highp vec4 sample21;
    highp vec4 sample23;
    highp vec4 sample25;
    highp vec4 sample27;
    highp vec4 sample28;
    highp vec4 samplePF0;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_x;
    pixSize;
    samplePF0 = texture(texUnit0, texCoord.xy);
    r0_z = samplePF0.x;
    r0_w = texCoord.x;
    r1_x = texCoord.y;
    r0_x = r0_w - pixSize.x;
    r0_y = r1_x - pixSize.y;
    r1_y = r0_w + pixSize.z;
    r1_z = r1_x + pixSize.w;
    r1_w = r0_w + pixSize.x;
    r2_y = r0_w - pixSize.z;
    r2_z = r0_w - pixSize.w;
    r2_x = r1_x + pixSize.y;
    r3_x = r0_y;
    r2_w = r2_y;
    r3_y = r1_w;
    r3_z = r1_z;
    r0_w = r0_w + pixSize.w;
    r2_y = r2_z;
    r2_z = r0_y;
    r3_w = r1_y;
    r4_x = r2_x;
    r1_x = r2_x;
    sample18 = texture(texUnit0, vec2(r0_x, r0_y));
    r0_x = sample18.x;
    sample19 = texture(texUnit0, vec2(r2_w, r3_x));
    r0_y = sample19.x;
    sample20 = texture(texUnit0, vec2(r1_y, r1_z));
    r1_y = sample20.x;
    sample21 = texture(texUnit0, vec2(r3_y, r3_z));
    r1_z = sample21.x;
    sample23 = texture(texUnit0, vec2(r2_y, r2_z));
    r2_y = sample23.x;
    sample25 = texture(texUnit0, vec2(r3_w, r4_x));
    r2_z = sample25.x;
    sample27 = texture(texUnit0, vec2(r0_w, r1_x));
    r0_w = sample27.x;
    sample28 = texture(texUnit0, vec2(r1_w, r2_x));
    r1_x = sample28.x;
    r0_z = r0_z * 2.0;
    r0_z = r0_z * 2.0;
    r0_x = 2.0 * r1_y + r0_x;
    r0_y = 2.0 * r1_z + r0_y;
    r0_z = 2.0 * r2_y + r0_z;
    r0_z = 2.0 * r0_w + r0_z;
    r0_x = r0_x + r2_z;
    r0_y = r0_y + r1_x;
    r0_x = r0_x + r0_z;
    r0_x = r0_x + r0_y;
    r0_x = r0_x * 0.0625;
    r0_y = 0.0;
    r0_z = 0.0;
    r0_w = 0.0;
    fragColor = vec4(r0_x, r0_y, r0_z, r0_w);
}
