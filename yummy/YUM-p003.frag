#version 100
precision highp float;

uniform highp sampler2D texUnitC;
uniform highp sampler2D texUnitYAfter;
uniform highp sampler2D table2;
uniform highp vec4 pixSize;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample14;
    highp vec4 sample16;
    highp vec4 sample6;
    highp vec4 samplePF0;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    pixSize;
    samplePF0 = texture2D(texUnitC, texCoord.xy);
    r0_z = samplePF0.x;
    r0_w = samplePF0.y;
    r1_x = samplePF0.z;
    r1_y = samplePF0.w;
    r1_z = texCoord.x;
    r1_w = texCoord.y;
    r0_y = 0.5;
    r2_x = 0.5;
    r1_z = r1_z + pixSize.x;
    r1_w = r1_w + pixSize.y;
    sample6 = texture2D(texUnitYAfter, vec2(r1_z, r1_w));
    r2_y = sample6.x;
    r2_w = sample6.z;
    r0_z = 255.0 * r0_z + -128.0;
    r0_w = 255.0 * r0_w + -128.0;
    r1_x = 255.0 * r1_x + -128.0;
    r1_y = 255.0 * r1_y + -128.0;
    r0_x = 255.0 * r2_y + 0.5;
    r1_z = 255.0 * r2_w + 0.5;
    r0_x = r0_x * 0.00390625;
    r1_z = r1_z * 0.00390625;
    r1_w = r1_z;
    sample14 = texture2D(table2, vec2(r0_x, r0_y));
    r0_x = sample14.x;
    sample16 = texture2D(table2, vec2(r1_w, r2_x));
    r0_y = sample16.x;
    r0_x = r0_x * 255.0;
    r0_y = r0_y * 255.0;
    r0_z = r0_x * r0_z;
    r0_x = r0_x * r0_w;
    r0_w = r0_y * r1_x;
    r0_y = r0_y * r1_y;
    r1_x = r0_z * 0.0078125;
    r1_y = r0_x * 0.0078125;
    r1_z = r0_w * 0.0078125;
    r1_w = r0_y * 0.0078125;
    r1_x = (r1_x < 0.0) ? 1.0 : 0.0;
    r1_y = (r1_y < 0.0) ? 1.0 : 0.0;
    r1_z = (r1_z < 0.0) ? 1.0 : 0.0;
    r1_w = (r1_w < 0.0) ? 1.0 : 0.0;
    r1_x = (r1_x != 0.0) ? 0.0 : 1.0;
    r1_y = (r1_y != 0.0) ? 0.0 : 1.0;
    r1_z = (r1_z != 0.0) ? 0.0 : 1.0;
    r1_w = (r1_w != 0.0) ? 0.0 : 1.0;
    r2_x = 1.0 - r1_x;
    r2_y = 1.0 - r1_y;
    r2_z = 1.0 - r1_z;
    r2_w = 1.0 - r1_w;
    r3_x = r1_x * 0.5;
    r3_y = r1_y * 0.5;
    r3_z = r1_z * 0.5;
    r3_w = r1_w * 0.5;
    r3_x = -0.5 * r2_x + r3_x;
    r3_y = -0.5 * r2_y + r3_y;
    r3_z = -0.5 * r2_z + r3_z;
    r3_w = -0.5 * r2_w + r3_w;
    r0_z = 0.0078125 * r0_z + r3_x;
    r0_x = 0.0078125 * r0_x + r3_y;
    r0_w = 0.0078125 * r0_w + r3_z;
    r0_y = 0.0078125 * r0_y + r3_w;
    r0_z = floor(abs(r0_z));
    r0_x = floor(abs(r0_x));
    r0_w = floor(abs(r0_w));
    r0_y = floor(abs(r0_y));
    r1_x = r1_x - r2_x;
    r1_y = r1_y - r2_y;
    r1_z = r1_z - r2_z;
    r1_w = r1_w - r2_w;
    r0_z = r0_z * r1_x + 128.0;
    r0_x = r0_x * r1_y + 128.0;
    r0_w = r0_w * r1_z + 128.0;
    r0_y = r0_y * r1_w + 128.0;
    r0_z = max(r0_z, 0.0);
    r0_x = max(r0_x, 0.0);
    r0_w = max(r0_w, 0.0);
    r0_y = max(r0_y, 0.0);
    r0_z = min(r0_z, 255.0);
    r0_x = min(r0_x, 255.0);
    r0_w = min(r0_w, 255.0);
    r0_y = min(r0_y, 255.0);
    hr0_x = r0_z * 0.003921568859368563;
    hr0_y = r0_x * 0.003921568859368563;
    hr0_z = r0_w * 0.003921568859368563;
    hr0_w = r0_y * 0.003921568859368563;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
