#version 100
#extension GL_OES_EGL_image_external : require
precision highp float;

uniform highp samplerExternalOES texUnit0;
uniform highp sampler2D table;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    mediump vec4 sample18;
    mediump vec4 sample25;
    mediump vec4 sample27;
    mediump vec4 sample28;
    highp vec4 samplePF0;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    mediump float hr1_x;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_x;
    highp float r63_x;
    samplePF0 = texture2D(texUnit0, texCoord.xy);
    r0_z = samplePF0.x;
    r0_w = samplePF0.y;
    r1_x = samplePF0.z;
    r1_y = samplePF0.w;
    r63_x = texCoord.x;
    r0_y = 0.5;
    r1_z = 0.5;
    r2_x = 0.5;
    r2_z = 0.5;
    r0_x = 0.0;
    r0_x = 0.0;
    r2_w = 0.0 * r1_y;
    r3_x = 0.0 * r1_y;
    r1_w = 0.0 * r1_y;
    r2_y = (r0_x != 0.0) ? 1.0 : r1_y;
    r2_w = 0.0 * r1_x + r2_w;
    r3_x = 0.0 * r1_x + r3_x;
    r1_y = 0.0 * r1_x + r1_w;
    r2_w = 0.0 * r0_w + r2_w;
    r3_x = 0.0 * r0_w + r3_x;
    r1_y = 0.0 * r0_w + r1_y;
    r2_w = 0.0 * r0_z + r2_w;
    r3_x = 0.0 * r0_z + r3_x;
    r1_y = 0.0 * r0_z + r1_y;
    sample18 = texture2D(table, vec2(r2_y, r2_z));
    hr0_x = sample18.x;
    r0_z = (r0_x != 0.0) ? r2_w : r0_z;
    r0_w = (r0_x != 0.0) ? r3_x : r0_w;
    r1_w = (r0_x != 0.0) ? r1_y : r1_x;
    r0_x = r0_z;
    r1_y = r0_w;
    sample25 = texture2D(table, vec2(r0_x, r0_y));
    hr0_y = sample25.x;
    sample27 = texture2D(table, vec2(r1_y, r1_z));
    hr0_z = sample27.x;
    sample28 = texture2D(table, vec2(r1_w, r2_x));
    hr0_w = sample28.x;
    hr1_x = hr0_y;
    hr0_y = hr0_z;
    hr0_z = hr0_w;
    hr0_w = hr0_x;
    hr0_x = hr1_x;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
