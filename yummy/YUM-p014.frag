#version 100
precision highp float;

uniform highp sampler2D texUnitSrc;
uniform highp sampler2D texUnitH;
uniform highp sampler2D texUnitAlpha;
uniform highp vec4 pixSize;
uniform highp vec4 pixSize2;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample20;
    highp vec4 sample22;
    highp vec4 sample24;
    highp vec4 sample26;
    highp vec4 samplePF0;
    highp vec4 samplePF1;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_x;
    pixSize;
    pixSize2;
    samplePF0 = texture2D(texUnitSrc, texCoord.xy);
    r0_z = samplePF0.x;
    r0_w = samplePF0.y;
    r1_x = samplePF0.z;
    r1_y = samplePF0.w;
    samplePF1 = texture2D(texUnitH, texCoord.xy);
    r1_z = samplePF1.x;
    r1_w = samplePF1.y;
    r2_x = samplePF1.z;
    r2_y = samplePF1.w;
    r2_z = texCoord.x;
    r2_w = texCoord.y;
    r0_x = r2_w * pixSize.w;
    r0_y = r2_z - pixSize.y;
    r3_x = r2_z + pixSize.x;
    r2_w = pixSize.w * r2_w + 0.0;
    r3_y = pixSize2.y * r0_x + pixSize2.w;
    r0_x = pixSize2.x * r0_y + pixSize2.z;
    r0_y = r2_z - pixSize.x;
    r2_w = pixSize2.y * r2_w + pixSize2.w;
    r3_z = pixSize2.x * r3_x + pixSize2.z;
    r2_z = r2_z + pixSize.y;
    r3_w = r0_x;
    r4_x = r3_y;
    r3_x = pixSize2.x * r0_y + pixSize2.z;
    r0_x = r3_z;
    r0_y = r2_w;
    r2_z = pixSize2.x * r2_z + pixSize2.z;
    sample20 = texture2D(texUnitAlpha, vec2(r3_w, r4_x));
    r3_z = sample20.x;
    sample22 = texture2D(texUnitAlpha, vec2(r3_x, r3_y));
    r3_x = sample22.x;
    sample24 = texture2D(texUnitAlpha, vec2(r0_x, r0_y));
    r0_x = sample24.x;
    sample26 = texture2D(texUnitAlpha, vec2(r2_z, r2_w));
    r0_y = sample26.x;
    r1_z = r1_z * 255.0;
    r1_w = r1_w * 255.0;
    r2_x = r2_x * 255.0;
    r2_y = r2_y * 255.0;
    r0_z = r0_z * 255.0;
    r0_w = r0_w * 255.0;
    r1_x = r1_x * 255.0;
    r1_y = r1_y * 255.0;
    r2_z = 1.0 - r3_z;
    r2_w = 1.0 - r3_x;
    r3_y = 1.0 - r0_x;
    r3_w = 1.0 - r0_y;
    r1_z = r1_z * r3_z;
    r1_w = r1_w * r3_x;
    r0_x = r0_x * r2_x;
    r0_y = r0_y * r2_y;
    r0_z = r0_z * r2_z + r1_z;
    r0_w = r0_w * r2_w + r1_w;
    r0_x = r1_x * r3_y + r0_x;
    r0_y = r1_y * r3_w + r0_y;
    r0_z = floor(r0_z);
    r0_w = floor(r0_w);
    r0_x = floor(r0_x);
    r0_y = floor(r0_y);
    hr0_x = r0_z * 0.003921568859368563;
    hr0_y = r0_w * 0.003921568859368563;
    hr0_z = r0_x * 0.003921568859368563;
    hr0_w = r0_y * 0.003921568859368563;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
