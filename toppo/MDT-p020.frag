#version 100
#extension GL_OES_EGL_image_external : require
precision highp float;

uniform highp samplerExternalOES texUnit0;
uniform highp vec2 pixSize;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample10;
    highp vec4 sample13;
    highp vec4 sample15;
    highp vec4 sample17;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_w;
    highp float r4_x;
    highp float r4_y;
    highp float r4_z;
    highp float r5_w;
    highp float r5_x;
    highp float r5_y;
    highp float r5_z;
    highp float r6_x;
    highp float r6_y;
    pixSize;
    r0_z = pixSize.x;
    r0_w = pixSize.y;
    r1_x = texCoord.x;
    r1_y = texCoord.y;
    r1_z = (-0.5) * r0_z + r1_x;
    r1_w = (-0.5) * r0_w + r1_y;
    r0_y = 0.5 * r0_w + r1_y;
    r0_x = 0.5 * r0_z + r1_x;
    r0_z = r1_z;
    r0_w = r1_w;
    r1_x = r1_z;
    r1_y = r0_y;
    r1_z = r0_x;
    sample10 = texture2D(texUnit0, vec2(r0_x, r0_y));
    r2_x = sample10.x;
    r2_y = sample10.y;
    r2_z = sample10.z;
    r2_w = sample10.w;
    r4_x = 0.0;
    sample13 = texture2D(texUnit0, vec2(r0_z, r0_w));
    r0_x = sample13.x;
    r0_y = sample13.y;
    r0_z = sample13.z;
    r0_w = sample13.w;
    sample15 = texture2D(texUnit0, vec2(r1_x, r1_y));
    r3_x = sample15.x;
    r3_y = sample15.y;
    r3_z = sample15.z;
    r3_w = sample15.w;
    r4_x = 0.0;
    sample17 = texture2D(texUnit0, vec2(r1_z, r1_w));
    r1_x = sample17.x;
    r1_y = sample17.y;
    r1_z = sample17.z;
    r1_w = sample17.w;
    hr0_x = r4_x;
    r4_x = hr0_x;
    hr0_x = hr0_x;
    p0 = hr0_x == 1.0;
    r4_y = 0.0 * r0_w;
    r4_z = 0.0 * r0_w;
    r4_w = 0.0 * r0_w;
    r5_x = 0.0 * r3_w;
    r5_y = 0.0 * r3_w;
    r5_z = 0.0 * r3_w;
    r5_w = 0.0 * r1_w;
    r6_x = 0.0 * r1_w;
    r6_y = 0.0 * r1_w;
    r4_y = 0.0 * r0_z + r4_y;
    r4_z = 0.0 * r0_z + r4_z;
    r4_w = 0.0 * r0_z + r4_w;
    r5_x = 0.0 * r3_z + r5_x;
    r5_y = 0.0 * r3_z + r5_y;
    r5_z = 0.0 * r3_z + r5_z;
    r5_w = 0.0 * r1_z + r5_w;
    r6_x = 0.0 * r1_z + r6_x;
    r6_y = 0.0 * r1_z + r6_y;
    r4_y = 0.0 * r0_y + r4_y;
    r4_z = 0.0 * r0_y + r4_z;
    r4_w = 0.0 * r0_y + r4_w;
    r5_x = 0.0 * r3_y + r5_x;
    r5_y = 0.0 * r3_y + r5_y;
    r5_z = 0.0 * r3_y + r5_z;
    r5_w = 0.0 * r1_y + r5_w;
    r6_x = 0.0 * r1_y + r6_x;
    r6_y = 0.0 * r1_y + r6_y;
    r4_y = 0.0 * r0_x + r4_y;
    r4_z = 0.0 * r0_x + r4_z;
    r4_w = 0.0 * r0_x + r4_w;
    r5_x = 0.0 * r3_x + r5_x;
    r5_y = 0.0 * r3_x + r5_y;
    r5_z = 0.0 * r3_x + r5_z;
    r5_w = 0.0 * r1_x + r5_w;
    r6_x = 0.0 * r1_x + r6_x;
    r6_y = 0.0 * r1_x + r6_y;
    r0_x = (r4_x != 0.0) ? r4_y : r0_x;
    r0_y = (r4_x != 0.0) ? r4_z : r0_y;
    r0_z = (r4_x != 0.0) ? r4_w : r0_z;
    r0_w = (r4_x != 0.0) ? 1.0 : r0_w;
    r3_x = (r4_x != 0.0) ? r5_x : r3_x;
    r3_y = (r4_x != 0.0) ? r5_y : r3_y;
    r3_z = (r4_x != 0.0) ? r5_z : r3_z;
    r3_w = (r4_x != 0.0) ? 1.0 : r3_w;
    r1_x = (r4_x != 0.0) ? r5_w : r1_x;
    r1_y = (r4_x != 0.0) ? r6_x : r1_y;
    r1_z = (r4_x != 0.0) ? r6_y : r1_z;
    r1_w = (r4_x != 0.0) ? 1.0 : r1_w;
    if (!p0)
    {
        r4_y = r2_x;
    }
    else
    {
        r4_x = 0.0 * r2_w;
        r4_y = 0.0 * r2_w;
        r2_w = 0.0 * r2_w;
        r4_x = 0.0 * r2_z + r4_x;
        r4_y = 0.0 * r2_z + r4_y;
        r2_z = 0.0 * r2_z + r2_w;
        r2_w = 0.0 * r2_y + r4_x;
        r4_x = 0.0 * r2_y + r4_y;
        r2_z = 0.0 * r2_y + r2_z;
        r4_y = 0.0 * r2_x + r2_w;
        r2_y = 0.0 * r2_x + r4_x;
        r2_z = 0.0 * r2_x + r2_z;
        r2_w = 1.0;
    }
    r0_x = r0_x + r0_y;
    r0_y = r0_z + r0_w;
    r0_z = r1_x + r1_y;
    r0_w = r1_z + r1_w;
    r0_x = r0_x + r3_x;
    r0_y = r0_y + r3_z;
    r0_z = r0_z + r4_y;
    r0_w = r0_w + r2_z;
    r0_x = r0_x + r3_y;
    r0_y = r0_y + r3_w;
    r0_z = r0_z + r2_y;
    r0_w = r0_w + r2_w;
    r0_x = 0.25 * r0_x + 3.9999999e-05;
    r0_y = 0.25 * r0_y + 3.9999999e-05;
    r0_z = 0.25 * r0_z + 3.9999999e-05;
    r0_w = 0.25 * r0_w + 3.9999999e-05;
    r0_x = 255.0 * r0_x + 0.5;
    r0_y = 255.0 * r0_y + 0.5;
    r0_z = 255.0 * r0_z + 0.5;
    r0_w = 255.0 * r0_w + 0.5;
    r0_x = floor(r0_x);
    r0_y = floor(r0_y);
    r0_z = floor(r0_z);
    r0_w = floor(r0_w);
    hr0_x = r0_x * 0.003921568859368563;
    hr0_y = r0_y * 0.003921568859368563;
    hr0_z = r0_z * 0.003921568859368563;
    hr0_w = r0_w * 0.003921568859368563;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
