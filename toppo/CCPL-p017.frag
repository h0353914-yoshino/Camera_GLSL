#version 100
#extension GL_OES_EGL_image_external : require
precision highp float;

uniform highp samplerExternalOES texUnit1;
uniform highp samplerExternalOES texUnit2;
uniform highp vec4 param;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample13;
    highp vec4 sample14;
    highp vec4 sample15;
    highp vec4 sample16;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_w;
    highp float r4_x;
    highp float r4_y;
    highp float r4_z;
    highp float r5_x;
    param;
    r0_z = param.y;
    r0_w = texCoord.x;
    r1_x = texCoord.y;
    r1_y = 1.0;
    r0_x = (-0.25) * r0_z + r0_w;
    r0_y = r1_x;
    r0_z = 0.25 * r0_z + r0_w;
    r0_w = r1_x + 0.0;
    r1_x = 0.0;
    r4_x = 0.0;
    r4_y = param.x;
    hr0_x = r1_x;
    sample13 = texture2D(texUnit1, vec2(r0_z, r0_w));
    r1_x = sample13.x;
    r1_y = sample13.y;
    r1_z = sample13.z;
    r1_w = sample13.w;
    sample14 = texture2D(texUnit1, vec2(r0_x, r0_y));
    r2_x = sample14.x;
    r2_y = sample14.y;
    r2_z = sample14.z;
    r2_w = sample14.w;
    sample15 = texture2D(texUnit2, vec2(r0_x, r0_y));
    r3_x = sample15.x;
    r3_y = sample15.y;
    r3_z = sample15.z;
    r3_w = sample15.w;
    sample16 = texture2D(texUnit2, vec2(r0_z, r0_w));
    r0_x = sample16.x;
    r0_y = sample16.y;
    r0_z = sample16.z;
    r0_w = sample16.w;
    r4_x = 0.0;
    r4_z = hr0_x;
    hr0_x = hr0_x;
    p0 = hr0_x == 1.0;
    r4_w = 0.0 * r1_w;
    r5_x = 0.0 * r2_w;
    r1_z = 0.0 * r1_z + r4_w;
    r2_z = 0.0 * r2_z + r5_x;
    r1_z = 0.0 * r1_y + r1_z;
    r2_z = 0.0 * r2_y + r2_z;
    r4_w = 0.0 * r3_w;
    r2_x = 0.0 * r2_x + r2_z;
    r1_x = 0.0 * r1_x + r1_z;
    r1_z = 0.0 * r3_z + r4_w;
    r2_z = (r4_x != 0.0) ? 1.0 : r2_w;
    r1_z = 0.0 * r3_y + r1_z;
    r2_x = (r4_x != 0.0) ? r2_x : r2_y;
    r1_x = (r4_x != 0.0) ? r1_x : r1_y;
    r1_y = (r4_x != 0.0) ? 1.0 : r1_w;
    r1_z = 0.0 * r3_x + r1_z;
    r1_w = r2_x + -0.501960813999176;
    r2_x = r2_z + -0.501960813999176;
    r1_x = r1_x + -0.501960813999176;
    r1_y = r1_y + -0.501960813999176;
    r1_z = (r4_z != 0.0) ? r1_z : r3_y;
    r2_y = (r4_z != 0.0) ? 1.0 : r3_w;
    if (p0)
    {
        r0_w = 0.0 * r0_w;
        r0_z = 0.0 * r0_z + r0_w;
        r0_y = 0.0 * r0_y + r0_z;
        r0_y = 0.0 * r0_x + r0_y;
        r0_w = 1.0;
    }
    r0_x = r1_z + -0.501960813999176;
    r0_z = r2_y + -0.501960813999176;
    r1_z = 1.0 - r4_y;
    r0_y = r0_y + -0.501960813999176;
    r0_x = r0_x * param.x;
    r0_z = r0_z * param.x;
    r0_x = r1_z * r1_w + r0_x;
    r0_y = r0_y * param.x;
    r0_z = r1_z * r2_x + r0_z;
    r0_y = r1_x * r1_z + r0_y;
    r0_w = r0_w + -0.501960813999176;
    r0_w = r0_w * param.x;
    r0_w = r1_y * r1_z + r0_w;
    hr0_x = r0_x + 0.501960813999176;
    hr0_y = r0_z + 0.501960813999176;
    hr0_z = r0_y + 0.501960813999176;
    hr0_w = r0_w + 0.501960813999176;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
