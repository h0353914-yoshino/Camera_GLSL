#version 100
#extension GL_OES_EGL_image_external : require
precision highp float;

uniform highp samplerExternalOES texUnit1;
uniform highp samplerExternalOES texUnit2;
uniform highp sampler2D texUnit3;
uniform highp vec4 param;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample15;
    highp vec4 sample16;
    highp vec4 samplePF0;
    highp vec4 samplePF1;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_x;
    highp float r4_y;
    param;
    samplePF0 = texture2D(texUnit1, texCoord.xy);
    r0_z = samplePF0.x;
    r0_w = samplePF0.y;
    r1_x = samplePF0.z;
    r1_y = samplePF0.w;
    samplePF1 = texture2D(texUnit2, texCoord.xy);
    r1_z = samplePF1.x;
    r1_w = samplePF1.y;
    r2_x = samplePF1.z;
    r2_y = samplePF1.w;
    r2_z = texCoord.x;
    r2_w = texCoord.y;
    r0_x = param.y;
    r0_y = 1.0;
    r3_x = r2_w;
    r3_z = r2_w;
    r0_x = r0_x * 0.5;
    r2_w = param.w * r2_z + (-r0_x);
    r3_y = param.w * r2_z + r0_x;
    r0_x = 0.0;
    r0_y = 0.0;
    r0_y = 0.0;
    sample15 = texture2D(texUnit3, vec2(r2_w, r3_x));
    r2_z = sample15.x;
    sample16 = texture2D(texUnit3, vec2(r3_y, r3_z));
    r2_w = sample16.x;
    r3_x = 0.0 * r2_y;
    r3_y = 0.0 * r2_y;
    r3_z = 0.0 * r2_y;
    r3_w = 0.0 * r1_y;
    r4_x = 0.0 * r1_y;
    r4_y = 0.0 * r1_y;
    r3_x = 0.0 * r2_x + r3_x;
    r3_y = 0.0 * r2_x + r3_y;
    r3_z = 0.0 * r2_x + r3_z;
    r3_w = 0.0 * r1_x + r3_w;
    r4_x = 0.0 * r1_x + r4_x;
    r4_y = 0.0 * r1_x + r4_y;
    r3_x = 0.0 * r1_w + r3_x;
    r3_y = 0.0 * r1_w + r3_y;
    r3_z = 0.0 * r1_w + r3_z;
    r3_w = 0.0 * r0_w + r3_w;
    r4_x = 0.0 * r0_w + r4_x;
    r4_y = 0.0 * r0_w + r4_y;
    r3_x = 0.0 * r1_z + r3_x;
    r3_y = 0.0 * r1_z + r3_y;
    r3_z = 0.0 * r1_z + r3_z;
    r3_w = 0.0 * r0_z + r3_w;
    r4_x = 0.0 * r0_z + r4_x;
    r4_y = 0.0 * r0_z + r4_y;
    r1_z = (r0_x != 0.0) ? r3_x : r1_z;
    r1_w = (r0_x != 0.0) ? r3_y : r1_w;
    r2_x = (r0_x != 0.0) ? r3_z : r2_x;
    r0_x = (r0_x != 0.0) ? 1.0 : r2_y;
    r0_z = (r0_y != 0.0) ? r3_w : r0_z;
    r0_w = (r0_y != 0.0) ? r4_x : r0_w;
    r1_x = (r0_y != 0.0) ? r4_y : r1_x;
    r0_y = (r0_y != 0.0) ? 1.0 : r1_y;
    r1_y = r2_z * param.x;
    r2_y = r2_w * param.x;
    r1_z = r1_z + -0.501960813999176;
    r1_w = r1_w + -0.501960813999176;
    r2_x = r2_x + -0.501960813999176;
    r0_x = r0_x + -0.501960813999176;
    r2_z = (-param.x) * r2_z + 1.0;
    r2_w = (-param.x) * r2_w + 1.0;
    r0_z = r0_z + -0.501960813999176;
    r0_w = r0_w + -0.501960813999176;
    r1_x = r1_x + -0.501960813999176;
    r0_y = r0_y + -0.501960813999176;
    r1_z = r1_y * r1_z;
    r1_y = r1_y * r1_w;
    r1_w = r2_x * r2_y;
    r0_x = r0_x * r2_y;
    r0_z = r0_z * r2_z + r1_z;
    r0_w = r0_w * r2_z + r1_y;
    r1_x = r1_x * r2_w + r1_w;
    r0_x = r0_y * r2_w + r0_x;
    hr0_y = r0_z + 0.501960813999176;
    hr0_x = r0_w + 0.501960813999176;
    hr0_w = r1_x + 0.501960813999176;
    hr0_z = r0_x + 0.501960813999176;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
