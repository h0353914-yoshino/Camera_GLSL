#version 100
precision highp float;

uniform highp sampler2D texUnit1;
uniform highp sampler2D texUnit2;
uniform highp sampler2D texUnit3;
uniform highp vec4 param;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample11;
    highp vec4 sample12;
    highp vec4 samplePF0;
    highp vec4 samplePF1;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_x;
    param;
    samplePF0 = texture2D(texUnit1, texCoord.xy);
    r0_z = samplePF0.x;
    r0_w = samplePF0.y;
    r1_x = samplePF0.z;
    r1_y = samplePF0.w;
    samplePF1 = texture2D(texUnit2, texCoord.xy);
    r1_z = samplePF1.x;
    r1_w = samplePF1.y;
    r2_x = samplePF1.z;
    r2_y = samplePF1.w;
    r2_z = texCoord.x;
    r2_w = texCoord.y;
    r0_x = param.y;
    r0_y = r2_w;
    r0_x = r0_x * 0.5;
    r3_x = param.w * r2_z + (-r0_x);
    r2_z = param.w * r2_z + r0_x;
    r0_x = r3_x;
    sample11 = texture2D(texUnit3, vec2(r0_x, r0_y));
    r0_x = sample11.x;
    sample12 = texture2D(texUnit3, vec2(r2_z, r2_w));
    r0_y = sample12.x;
    r1_z = r1_z + -0.501960813999176;
    r1_w = r1_w + -0.501960813999176;
    r2_x = r2_x + -0.501960813999176;
    r2_y = r2_y + -0.501960813999176;
    r0_z = r0_z + -0.501960813999176;
    r0_w = r0_w + -0.501960813999176;
    r1_x = r1_x + -0.501960813999176;
    r1_y = r1_y + -0.501960813999176;
    r2_z = (-param.x) * r0_x + 1.0;
    r0_x = r0_x * param.x;
    r2_w = r0_y * param.x;
    r0_y = (-param.x) * r0_y + 1.0;
    r1_z = r0_x * r1_z;
    r0_x = r0_x * r1_w;
    r1_w = r2_x * r2_w;
    r2_x = r2_y * r2_w;
    r0_z = r0_z * r2_z + r1_z;
    r0_x = r0_w * r2_z + r0_x;
    r0_w = r0_y * r1_x + r1_w;
    r0_y = r0_y * r1_y + r2_x;
    hr0_y = r0_z + 0.501960813999176;
    hr0_x = r0_x + 0.501960813999176;
    hr0_w = r0_w + 0.501960813999176;
    hr0_z = r0_y + 0.501960813999176;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
