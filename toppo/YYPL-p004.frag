#version 100
#extension GL_OES_EGL_image_external : require
precision highp float;

uniform highp samplerExternalOES texUnit1;
uniform highp samplerExternalOES texUnit2;
uniform highp samplerExternalOES texUnit3;
uniform highp vec4 param;
uniform highp vec4 beta_param;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample19;
    highp vec4 sample21;
    highp vec4 sample24;
    highp vec4 sample26;
    highp vec4 samplePF0;
    highp vec4 samplePF1;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_w;
    highp float r4_x;
    highp float r4_y;
    highp float r4_z;
    highp float r5_w;
    highp float r5_x;
    highp float r5_y;
    highp float r5_z;
    highp float r6_x;
    param;
    beta_param;
    samplePF0 = texture2D(texUnit2, texCoord.xy);
    r0_z = samplePF0.x;
    r0_w = samplePF0.y;
    r1_x = samplePF0.z;
    r1_y = samplePF0.w;
    samplePF1 = texture2D(texUnit1, texCoord.xy);
    r1_z = samplePF1.x;
    r1_w = samplePF1.y;
    r2_x = samplePF1.z;
    r2_y = samplePF1.w;
    r2_z = texCoord.x;
    r2_w = texCoord.y;
    r0_x = param.y;
    r4_x = 2.0;
    r0_y = r2_w;
    r3_y = r2_w;
    r3_x = r0_x * 1.5;
    r0_x = r0_x * 0.5;
    r3_z = param.w * r2_z + (-r3_x);
    r3_w = param.w * r2_z + (-r0_x);
    r4_y = param.w * r2_z + r0_x;
    r2_z = param.w * r2_z + r3_x;
    r0_x = r3_z;
    r3_x = r3_w;
    r3_z = r4_y;
    r3_w = r2_w;
    r6_x = 0.0;
    sample19 = texture2D(texUnit3, vec2(r0_x, r0_y));
    r4_x = sample19.x;
    r4_y = sample19.y;
    r4_z = sample19.z;
    r4_w = sample19.w;
    sample21 = texture2D(texUnit3, vec2(r3_x, r3_y));
    r5_x = sample21.x;
    r5_y = sample21.y;
    r5_z = sample21.z;
    r5_w = sample21.w;
    r0_x = 0.0;
    sample24 = texture2D(texUnit3, vec2(r3_z, r3_w));
    r3_x = sample24.x;
    r3_y = sample24.y;
    r3_z = sample24.z;
    r3_w = sample24.w;
    hr0_x = r6_x;
    sample26 = texture2D(texUnit3, vec2(r2_z, r2_w));
    r2_z = sample26.x;
    r2_w = sample26.y;
    r3_x = sample26.z;
    r3_y = sample26.w;
    r0_x = 0.0;
    r0_y = 1.0;
    r2_z = hr0_x;
    hr0_x = hr0_x;
    r0_y = 0.0;
    p0 = hr0_x == 1.0;
    r2_w = 0.0 * r2_y;
    r3_x = 0.0 * r2_y;
    r3_z = 0.0 * r2_y;
    r4_x = 0.0 * r1_y;
    r4_y = 0.0 * r1_y;
    r4_z = 0.0 * r1_y;
    r2_w = 0.0 * r2_x + r2_w;
    r3_x = 0.0 * r2_x + r3_x;
    r3_z = 0.0 * r2_x + r3_z;
    r4_x = 0.0 * r1_x + r4_x;
    r4_y = 0.0 * r1_x + r4_y;
    r4_z = 0.0 * r1_x + r4_z;
    r2_w = 0.0 * r1_w + r2_w;
    r3_x = 0.0 * r1_w + r3_x;
    r3_z = 0.0 * r1_w + r3_z;
    r4_x = 0.0 * r0_w + r4_x;
    r4_y = 0.0 * r0_w + r4_y;
    r4_z = 0.0 * r0_w + r4_z;
    r2_w = 0.0 * r1_z + r2_w;
    r3_x = 0.0 * r1_z + r3_x;
    r3_z = 0.0 * r1_z + r3_z;
    r4_x = 0.0 * r0_z + r4_x;
    r4_y = 0.0 * r0_z + r4_y;
    r4_z = 0.0 * r0_z + r4_z;
    r1_z = (r0_x != 0.0) ? r2_w : r1_z;
    r1_w = (r0_x != 0.0) ? r3_x : r1_w;
    r2_x = (r0_x != 0.0) ? r3_z : r2_x;
    r0_x = (r0_x != 0.0) ? 1.0 : r2_y;
    r0_z = (r0_y != 0.0) ? r4_x : r0_z;
    r0_w = (r0_y != 0.0) ? r4_y : r0_w;
    r1_x = (r0_y != 0.0) ? r4_z : r1_x;
    r0_y = (r0_y != 0.0) ? 1.0 : r1_y;
    r1_y = r1_z * 255.0;
    r1_z = r1_w * 255.0;
    r1_w = r2_x * 255.0;
    r0_x = r0_x * 255.0;
    r0_z = r0_z * 255.0;
    r0_w = r0_w * 255.0;
    r1_x = r1_x * 255.0;
    r0_y = r0_y * 255.0;
    r2_x = (r2_z != 0.0) ? 1.0 : r4_w;
    r2_y = (r2_z != 0.0) ? 1.0 : r5_w;
    r2_z = (r2_z != 0.0) ? 1.0 : r3_w;
    if (p0)
    {
        r3_y = 1.0;
    }
    r2_w = beta_param.z;
    r2_x = r2_x * 255.0;
    r2_y = r2_y * 255.0;
    r2_z = r2_z * 255.0;
    r3_x = r3_y * 255.0;
    r3_y = (-beta_param.w) * r2_w + beta_param.x;
    r2_w = beta_param.w * r2_w;
    r3_z = r3_y * beta_param.y;
    r3_z = r3_z * 0.00390625;
    r2_x = r2_x * r3_z;
    r2_y = r2_y * r3_z;
    r2_z = r2_z * r3_z;
    r3_x = r3_x * r3_z;
    r0_z = r0_z * r2_w + r2_x;
    r0_w = r0_w * r2_w + r2_y;
    r1_x = r1_x * r2_w + r2_z;
    r0_y = r0_y * r2_w + r3_x;
    r2_x = beta_param.y;
    r2_y = beta_param.x;
    r2_x = 256.0 - r2_x;
    r2_y = 524288.0 - r2_y;
    r2_x = r2_x * r3_y;
    r2_x = 0.00390625 * r2_x + r2_y;
    r0_z = r1_y * r2_x + r0_z;
    r0_w = r1_z * r2_x + r0_w;
    r1_x = r1_w * r2_x + r1_x;
    r0_x = r0_x * r2_x + r0_y;
    r0_y = r0_z + 262144.0;
    r0_z = r0_w + 262144.0;
    r0_w = r1_x + 262144.0;
    r0_x = r0_x + 262144.0;
    r0_y = r0_y * 1.90734863e-06;
    r0_z = r0_z * 1.90734863e-06;
    r0_w = r0_w * 1.90734863e-06;
    r0_x = r0_x * 1.90734863e-06;
    hr0_x = r0_y * 0.003921568859368563;
    hr0_y = r0_z * 0.003921568859368563;
    hr0_z = r0_w * 0.003921568859368563;
    hr0_w = r0_x * 0.003921568859368563;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
