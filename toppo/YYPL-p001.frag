#version 100
precision highp float;

uniform highp sampler2D texUnit1;
uniform highp sampler2D texUnit2;
uniform highp sampler2D texUnit3;
uniform highp vec4 param;
varying highp vec2 texCoord;

void main()
{
    bool p0;
    bool p1;
    highp vec4 sample17;
    highp vec4 sample19;
    highp vec4 sample21;
    highp vec4 sample23;
    highp vec4 samplePF0;
    highp vec4 samplePF1;
    mediump float hr0_w;
    mediump float hr0_x;
    mediump float hr0_y;
    mediump float hr0_z;
    highp float r0_w;
    highp float r0_x;
    highp float r0_y;
    highp float r0_z;
    highp float r1_w;
    highp float r1_x;
    highp float r1_y;
    highp float r1_z;
    highp float r2_w;
    highp float r2_x;
    highp float r2_y;
    highp float r2_z;
    highp float r3_w;
    highp float r3_x;
    highp float r3_y;
    highp float r3_z;
    highp float r4_x;
    param;
    samplePF0 = texture2D(texUnit1, texCoord.xy);
    r0_z = samplePF0.x;
    r0_w = samplePF0.y;
    r1_x = samplePF0.z;
    r1_y = samplePF0.w;
    samplePF1 = texture2D(texUnit2, texCoord.xy);
    r1_z = samplePF1.x;
    r1_w = samplePF1.y;
    r2_x = samplePF1.z;
    r2_y = samplePF1.w;
    r2_z = param.y;
    r2_w = texCoord.x;
    r3_x = texCoord.y;
    r0_x = r2_z * 1.5;
    r0_y = r2_z * 0.5;
    r2_z = param.w * r2_w + (-r0_x);
    r3_y = param.w * r2_w + (-r0_y);
    r0_y = param.w * r2_w + r0_y;
    r0_x = param.w * r2_w + r0_x;
    r2_w = r3_x;
    r3_z = r3_x;
    r3_w = r0_y;
    r4_x = r3_x;
    r0_y = r3_x;
    sample17 = texture2D(texUnit3, vec2(r2_z, r2_w));
    r2_z = sample17.x;
    sample19 = texture2D(texUnit3, vec2(r3_y, r3_z));
    r2_w = sample19.x;
    sample21 = texture2D(texUnit3, vec2(r3_w, r4_x));
    r3_x = sample21.x;
    sample23 = texture2D(texUnit3, vec2(r0_x, r0_y));
    r0_x = sample23.x;
    r0_y = (-param.x) * r2_z + 1.0;
    r3_y = (-param.x) * r2_w + 1.0;
    r3_z = (-param.x) * r3_x + 1.0;
    r2_z = r2_z * param.x;
    r2_w = r2_w * param.x;
    r3_x = r3_x * param.x;
    r3_w = r0_x * param.x;
    r0_x = (-param.x) * r0_x + 1.0;
    r1_z = r1_z * r2_z;
    r1_w = r1_w * r2_w;
    r2_x = r2_x * r3_x;
    r2_y = r2_y * r3_w;
    hr0_x = r0_y * r0_z + r1_z;
    hr0_y = r0_w * r3_y + r1_w;
    hr0_z = r1_x * r3_z + r2_x;
    hr0_w = r0_x * r1_y + r2_y;
    gl_FragColor = vec4(hr0_x, hr0_y, hr0_z, hr0_w);
}
